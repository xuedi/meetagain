# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

# app settings
APP_ENV=dev
APP_HOST="http://localhost"
APP_SECRET=1b23f99fb5e114fbd4705e8774111e6d
APP_SECRET_BOX_KEY=ACgMr4NtZlF+FO5j4e0pKPDFslJhkM5NTvJ4hcbfNEA=

# docker
HOST_USERNAME=xuedi
HOST_UID=1000
HOST_GID=1000

# database
MARIADB_ROOT_PASSWORD=pAssW0rd
MARIADB_DATABASE=meetAgain
MARIADB_HOST=ma-db
MARIADB_USER=meetAgain
MARIADB_PASSWORD=UserPassW0rd
DATABASE_URL="mysql://${MARIADB_USER}:${MARIADB_PASSWORD}@${MARIADB_HOST}:3306/${MARIADB_DATABASE}?charset=utf8mb4"

# services
MAILER_DSN=smtp://mailpit:1025
REDIS_URL=redis://valkey:6379
SENTRY_DSN=
LOCK_DSN=flock

# Metrics: request timings, cron durations and runtime gauges, sent over UDP. Unset means off, at zero cost.
# Locally: start the collector and Grafana with `just dockerMetricsStart`, then set this in .env.local.
# METRICS_DSN=udp://victoriametrics:8089?app=meetagain

# Optional dev convenience: set these in the gitignored .env.local and the films and
# boardgames plugins use them for metadata lookups whenever their settings store no key.
# Never commit real keys here.
# TMDB_API_KEY=
# OMDB_API_KEY=
# BGG_API_TOKEN=

# Web Push (VAPID). Empty means push is switched off and every push entry point does nothing.
# Generate a pair with `bin/console app:push:vapid-keys`; the subject is a mailto: or https: contact URL.
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_VAPID_SUBJECT=mailto:info@meetagain.org
