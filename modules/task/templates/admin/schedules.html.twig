{% extends 'admin/base.html.twig' %}

{% block content %}

    <div class="container">

        {% include 'admin/_components/admin_tabs.html.twig' with {'adminTabs': adminTabs} only %}
        {% include 'admin/_components/admin_top.html.twig' with {'adminTop': adminTop} only %}

        <table class="table is-fullwidth">
            <thead>
            <tr>
                <th>{{ 'admin_task.col_task'|trans }}</th>
                <th>{{ 'admin_task.col_cadence'|trans }}</th>
                <th>{{ 'admin_task.col_next_run'|trans }}</th>
                <th>{{ 'admin_task.col_last_run'|trans }}</th>
                <th>{{ 'admin_task.col_status'|trans }}</th>
                <th>{{ 'admin_task.col_duration'|trans }}</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for schedule in schedules %}
                <tr>
                    <td class="is-nowrap"><code>{{ schedule.identifier }}</code></td>
                    <td class="is-nowrap"><code>{{ schedule.cadence.cron }}</code></td>
                    <td class="is-nowrap has-text-grey">{{ schedule.next ? schedule.next|date('Y-m-d H:i') : '-' }}</td>
                    {% if schedule.last %}
                        <td class="is-nowrap">
                            <a href="{{ path('app_admin_task_runs', {'task': schedule.identifier, 'range': 'all'}) }}">{{ schedule.last.startedAt|date('Y-m-d H:i:s') }}</a>
                        </td>
                        <td><span class="tag {{ schedule.last.status.tagVariant }}">{{ schedule.last.status.label|trans }}</span></td>
                        <td class="has-text-grey has-unit" data-unit="ms">{{ schedule.last.durationMs }}</td>
                    {% else %}
                        <td colspan="3" class="has-text-grey">{{ 'admin_task.never_ran'|trans }}</td>
                    {% endif %}
                    <td class="is-nowrap">
                        <a href="{{ path('app_admin_task_show', {'identifier': schedule.identifier}) }}"
                           title="{{ 'admin_task.action_details'|trans }}">
                            <span class="icon"><i class="fa fa-magnifying-glass"></i></span>
                        </a>
                        <a href="{{ path('app_admin_task_run_now', {'identifier': schedule.identifier}) }}"
                           class="button-as-icon"
                           title="{{ 'admin_task.action_run_now'|trans }}"
                           data-post
                           data-csrf-token="{{ csrf_token('app_admin_task_run_now' ~ schedule.identifier) }}">
                            <span class="icon"><i class="fa fa-play"></i></span>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="has-text-grey has-text-centered">{{ 'admin_task.empty_schedules'|trans }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

    </div>

{% endblock %}
