{% extends '@Boardgames/base_boardgames.html.twig' %}

{% block title %}{{ 'boardgames_game.page_title_manual'|trans }}{% endblock %}

{% block boardgames_body %}
<h1 class="title">{{ 'boardgames_game.page_title_manual'|trans }}</h1>

{{ form_start(form) }}
{{ form_errors(form) }}
{% for field in [form.name, form.yearPublished, form.minPlayers, form.maxPlayers, form.minPlaytime, form.maxPlaytime, form.description] %}
<div class="field">
    {{ form_label(field) }}
    <div class="control">{{ form_widget(field) }}</div>
    {{ form_errors(field) }}
</div>
{% endfor %}
{% if form.itemTags is defined %}
    <div class="field">{{ form_row(form.itemTags) }}</div>
{% endif %}
<div class="field mt-4">
    {{ form_widget(form.submit, {'attr': {'class': 'button is-primary'}}) }}
    <a href="{{ path('app_boardgames_gamelist') }}" class="button ml-2">{{ 'boardgames_game.button_cancel'|trans }}</a>
</div>
{{ form_end(form) }}
{% endblock %}
