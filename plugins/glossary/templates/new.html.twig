{% extends 'base.html.twig' %}

{% block title %}{{ 'glossary.button_new'|trans }}{% endblock %}

{% block body %}

    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">

                    <h1 class="title is-4">{{ 'glossary.button_new'|trans }}</h1>
                    <div class="box">

                        {{ form_start(form, {attr: {'data-action': 'glossary-new-submit'}}) }}
                        {% if form.vars.submitted and not form.vars.valid %}<span hidden data-action="glossary-new-error" data-action-field="{{ form.children|filter(child => (child.vars.errors ?? [])|length > 0)|keys|join(',') }}"></span>{% endif %}
                        {{ form_errors(form) }}
                        {{ form_row(form.phrase) }}
                        {% if form.secondary is defined %}{{ form_row(form.secondary) }}{% endif %}
                        {% include '_components/item/translation_fields.html.twig' with {'form': form, 'fields': ['definition']} only %}
                        {% if form.itemTags is defined %}{{ form_row(form.itemTags) }}{% endif %}
                        <div class="has-text-right mt-6">
                            <a data-action="glossary-cancel-click" data-action-place="new" href="{{ path('app_plugin_glossary') }}" class="button">{{ 'global.button_cancel'|trans }}</a>
                            <button type="submit" class="button is-link">{{ 'global.button_save'|trans }}</button>
                        </div>
                        {{ form_end(form) }}

                    </div>

                    <a href="{{ path('app_plugin_glossary') }}" class="is-size-7">{{ 'glossary.link_back_to_list'|trans }}</a>

                </div>
            </div>
        </div>
    </section>

{% endblock %}
