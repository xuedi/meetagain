{% extends 'base.html.twig' %}

{% block title %}{{ 'glossary.heading_edit'|trans }}{% endblock %}

{% block body %}

    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">

                    <h1 class="title is-4">{{ 'glossary.heading_edit'|trans }}</h1>
                    <div class="box">

                        {{ form_start(form) }}
                        {{ form_errors(form) }}
                        {{ form_row(form.phrase) }}
                        {% if form.secondary is defined %}{{ form_row(form.secondary) }}{% endif %}
                        {% include '_components/item/translation_fields.html.twig' with {'form': form, 'fields': ['definition']} only %}
                        {% if form.itemTags is defined %}{{ form_row(form.itemTags) }}{% endif %}
                        <div class="has-text-right mt-6">
                            <a href="{{ path('app_plugin_glossary') }}" class="button">{{ 'global.button_cancel'|trans }}</a>
                            <button type="submit" class="button is-link">{{ 'global.button_save'|trans }}</button>
                        </div>
                        {{ form_end(form) }}

                    </div>

                    {% if pendingProposals is not empty %}
                        <h2 class="title is-5">{{ 'glossary.heading_waiting_approval'|trans }}</h2>
                        {% for entry in pendingProposals %}
                            <div class="box has-background-info-light">
                                <p class="mb-2">
                                    <b>{{ entry.proposal.proposerName }}</b>
                                    <span class="has-text-grey">{{ entry.proposal.createdAt|time_diff }}</span>
                                </p>
                                {% for row in entry.rows %}
                                    {% include '_components/value_diff.html.twig' with {label: row.label, before: row.before, after: row.after} only %}
                                {% endfor %}
                            </div>
                        {% endfor %}
                    {% endif %}

                    <a href="{{ path('app_plugin_glossary') }}" class="is-size-7">{{ 'glossary.link_back_to_list'|trans }}</a>

                </div>
            </div>
        </div>
    </section>

{% endblock %}
