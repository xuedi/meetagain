{# Glossary cell rendered by the shared item-list component (core wraps it in the chosen layout). #}
{% set mode = viewMode ?? item_view_mode('glossary').value %}
{% if mode not in ['list', 'tiles', 'row'] %}{% set mode = 'list' %}{% endif %}
{% set showUrl = path('app_plugin_glossary_show', {id: entry.id}) %}

{% if mode == 'row' %}
    {% include '_components/item/styles/row.html.twig' with {
        href: showUrl,
        title: entry.phrase,
        subtitle: config.secondaryEnabled ? entry.secondary : null
    } %}
{% elseif mode == 'list' %}
    <td style="vertical-align: middle;">
        <a href="{{ showUrl }}" class="has-text-weight-medium"{% if entry.termLanguage %} lang="{{ entry.termLanguage }}"{% endif %}>{{ entry.phrase }}</a>
    </td>
    {% if config.secondaryEnabled %}<td style="vertical-align: middle;" class="has-text-grey">{{ entry.secondary }}</td>{% endif %}
    <td style="vertical-align: middle;" class="item-cell-prose">{{ definition|nl2br }}</td>
    {% if hasTags %}<td style="vertical-align: middle;">{{ tagLabels|join(', ') }}</td>{% endif %}
    {% if is_granted('ROLE_USER') %}
        <td style="vertical-align: middle;" class="has-text-right">
            {% if is_granted('ROLE_ORGANIZER') %}
                {% if hasPendingProposal %}
                    <a class="has-text-warning" href="{{ path('app_review_proposals', {targetType: 'glossary', targetId: entry.id}) }}"
                       title="{{ 'glossary.heading_changes_approval'|trans }}">
                        <i class="fa fa-edit"></i>
                    </a>
                {% else %}
                    <a href="{{ path('app_plugin_glossary_edit', {id: entry.id}) }}">
                        <i class="fas fa-edit"></i>
                    </a>
                {% endif %}
                <a class="has-text-danger" href="{{ path('app_plugin_glossary_delete_view', {id: entry.id}) }}">
                    <i class="fa fa-trash"></i>
                </a>
            {% else %}
                <a href="{{ path('app_contribution_correct', {type: 'glossary', id: entry.id}) }}">
                    <i class="fas fa-edit"></i>
                </a>
            {% endif %}
        </td>
    {% endif %}
{% else %}
    <div class="card" style="height: 100%;">
        <div class="card-content">
            <p class="title is-5"><a href="{{ showUrl }}"{% if entry.termLanguage %} lang="{{ entry.termLanguage }}"{% endif %}>{{ entry.phrase }}</a></p>
            {% if config.secondaryEnabled and entry.secondary %}
                <p class="subtitle is-6 has-text-grey">{{ entry.secondary }}</p>
            {% endif %}
            <p>{{ definition|nl2br }}</p>
        </div>
    </div>
{% endif %}
