{% extends '@Books/base_books.html.twig' %}

{% block title %}{{ 'books_book.browser_title_list'|trans }}{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/vendor/fancybox.umd.js') }}"></script>
{% endblock %}

{% block books_body %}
<div class="level mb-4">
    <div class="level-left">
        <h1 class="title mb-0">{{ 'books_book.page_title_list'|trans }}</h1>
    </div>
    <div class="level-right">
        <div class="buttons">
            {% if circulation_dashboard_url('book') %}
                <a href="{{ circulation_dashboard_url('book') }}" class="button">
                    <span class="icon"><i class="fa fa-right-left"></i></span>
                    <span>{{ 'circulation.link_label'|trans }}</span>
                </a>
            {% endif %}
            {% if is_granted('ROLE_STEWARD') %}
                <a href="{{ path('app_plugin_books_book_add') }}" class="button is-link">
                    <span class="icon"><i class="fa fa-magnifying-glass"></i></span>
                    <span>{{ 'books_book.button_lookup'|trans }}</span>
                </a>
                <a href="{{ path('app_plugin_books_book_manual') }}" class="button">
                    <span class="icon"><i class="fa fa-plus"></i></span>
                    <span>{{ 'books_book.button_manual'|trans }}</span>
                </a>
            {% endif %}
        </div>
    </div>
</div>

{% include '_components/item/list_layout.html.twig' with {'itemType': 'book', 'infoKey': 'books_book.sidebar_info'} only %}
{% endblock %}
