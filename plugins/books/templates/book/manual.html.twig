{% extends '@Books/base_books.html.twig' %}

{% block title %}{{ 'books_book.page_title_manual'|trans }}{% endblock %}

{% block books_body %}
<h1 class="title">{{ 'books_book.page_title_manual'|trans }}</h1>

{{ form_start(form, {attr: {'data-action': 'books-manual-submit'}}) }}
{% if form.vars.submitted and not form.vars.valid %}<span hidden data-action="books-manual-error" data-action-field="{{ form.children|filter(child => (child.vars.errors ?? [])|length > 0)|keys|join(',') }}"></span>{% endif %}
{{ form_errors(form) }}
{% for field in [form.isbn, form.title, form.author, form.description, form.pageCount, form.publishedYear] %}
<div class="field">
    {{ form_label(field) }}
    <div class="control">{{ form_widget(field) }}</div>
    {{ form_errors(field) }}
</div>
{% endfor %}
{% if form.itemTags is defined %}
    <div class="field">{{ form_row(form.itemTags) }}</div>
{% endif %}
<div class="field mt-4">
    {{ form_widget(form.submit, {'attr': {'class': 'button is-primary'}}) }}
    <a data-action="books-cancel-click" data-action-place="manual" href="{{ path('app_books_booklist') }}" class="button ml-2">{{ 'books_book.button_cancel'|trans }}</a>
</div>
{{ form_end(form) }}
{% endblock %}
