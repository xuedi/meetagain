{% extends '@Books/base_books.html.twig' %}

{% block title %}{{ 'books_book.page_title_add'|trans }}{% endblock %}

{% block books_body %}
<div class="column is-6 pl-0">
    <h1 class="title">{{ 'books_book.page_title_add'|trans }}</h1>
    <p class="mb-5 has-text-grey">{{ 'books_book.add_intro'|trans }}</p>

    {{ form_start(form) }}
    {{ form_errors(form) }}
    <div class="field">
        {{ form_label(form.isbn) }}
        <div class="control has-icons-left">
            {{ form_widget(form.isbn, {'attr': {'class': 'input is-medium'}}) }}
            <span class="icon is-left"><i class="fa fa-barcode" aria-hidden="true"></i></span>
        </div>
        {{ form_errors(form.isbn) }}
    </div>
    {% if form.itemTags is defined %}
        <div class="field mt-4">{{ form_row(form.itemTags) }}</div>
    {% endif %}
    <div class="field mt-5">
        <button type="submit" class="button is-primary">{{ 'books_book.button_lookup'|trans }}</button>
        <a href="{{ path('app_plugin_books_book_manual') }}" class="button ml-2">{{ 'books_book.link_manual_entry'|trans }}</a>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}
