{# Steward picker to attach an existing photo to the event. Posts to the core attach route. #}
{% if photos is empty %}
    <p class="has-text-grey is-size-7">{{ 'photos.attach_empty'|trans }}</p>
{% else %}
    <form method="post" action="{{ path('app_item_attach', {id: eventId}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('app_item_attach' ~ eventId) }}">
        <input type="hidden" name="item_type" value="photo">
        <div class="field has-addons">
            <div class="control is-expanded">
                <div class="select is-small is-fullwidth">
                    <select name="item_id">
                        {% for photo in photos %}
                            <option value="{{ photo.id }}">{{ photo.getTranslatedTitle(app.locale) ?: 'photos.untitled'|trans }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>
            <div class="control">
                <button type="submit" class="button is-small is-link">{{ 'photos.attach_button'|trans }}</button>
            </div>
        </div>
    </form>
{% endif %}
