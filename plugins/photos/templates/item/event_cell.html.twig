{# Photo cell rendered for one EventItemAssociation on the event detail page. #}
{% set photoTitle = photo.getTranslatedTitle(app.locale) ?: 'photos.untitled'|trans %}
<div class="media">
    <div class="media-left">
        <a href="{{ path('app_plugin_photos_photo_show', {id: photo.id}) }}">
            {% include '_components/image.html.twig' with {'image': photo.visibleImage, 'size': '400x400', 'alt': photoTitle} %}
        </a>
    </div>
    <div class="media-content">
        <p class="title is-6 mb-1">
            <a href="{{ path('app_plugin_photos_photo_show', {id: photo.id}) }}">{{ photoTitle }}</a>
        </p>
        {% if photo.cameraLabel %}<p class="subtitle is-7 has-text-grey">{{ photo.cameraLabel }}</p>{% endif %}
        {% if is_granted('ROLE_ORGANIZER') %}
            <form method="post" action="{{ path('app_item_detach', {id: association.event.id}) }}" class="mt-2">
                <input type="hidden" name="_token" value="{{ csrf_token('app_item_detach' ~ association.event.id) }}">
                <input type="hidden" name="item_type" value="photo">
                <input type="hidden" name="item_id" value="{{ photo.id }}">
                <button type="submit" class="button is-small is-danger is-light">
                    <span class="icon"><i class="fa fa-times"></i></span>
                    <span>{{ 'photos.detach'|trans }}</span>
                </button>
            </form>
        {% endif %}
    </div>
</div>
