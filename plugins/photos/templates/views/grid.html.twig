{# Photos 'grid' layout - a dense strip of small image-only icons with a leading "add" icon. #}
<div class="columns is-multiline">
    {% if canAdd %}
        <div class="column is-1 p-1">
            <a href="{{ path('app_plugin_photos_photo_add') }}" title="{{ 'photos_views.title_add'|trans }}">
                <figure class="image" style="background: hsl(217, 71%, 95%); display: flex; align-items: center; justify-content: center; aspect-ratio: 1;">
                    <span class="icon has-text-link"><i class="fa-solid fa-plus fa-lg"></i></span>
                </figure>
            </a>
        </div>
    {% endif %}
    {% for item in photos %}
        <div class="column is-1 p-1">
            {% include '_components/item/styles/thumb.html.twig' with {
                href: path('app_plugin_photos_photo_show', {'id': item.id}),
                image: item.visibleImage,
                imageSize: '400x400',
                alt: item.getTranslatedTitle(app.locale) ?: 'photos.untitled'|trans,
                ratio: 'square'
            } %}
        </div>
    {% endfor %}
</div>
