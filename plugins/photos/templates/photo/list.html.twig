{% extends '@Photos/base_photos.html.twig' %}

{% block title %}{{ 'photos_photo.browser_title_list'|trans }}{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/vendor/fancybox.umd.js') }}"></script>
{% endblock %}

{% block photos_body %}
<div class="level mb-4">
    <div class="level-left">
        <h1 class="title mb-0">{{ 'photos_photo.page_title_list'|trans }}</h1>
    </div>
    <div class="level-right">
        {% if contestEnabled %}
            <a href="{{ path('app_plugin_photos_contest') }}" class="button mr-2">
                <span class="icon"><i class="fa-solid fa-trophy"></i></span>
                <span>{{ 'photos_contest.button_contest'|trans }}</span>
            </a>
        {% endif %}
        {% if streamsEnabled %}
            <a href="{{ path('app_plugin_photos_streams') }}" class="button">
                <span class="icon"><i class="fa fa-users"></i></span>
                <span>{{ 'photos_stream.button_all_streams'|trans }}</span>
            </a>
        {% endif %}
    </div>
</div>

{% include '_components/item/list_layout.html.twig' with {
    'itemType': 'photo',
    'defaultMode': 'gallery',
    'infoKey': 'photos_photo.sidebar_info'
} only %}
{% endblock %}
