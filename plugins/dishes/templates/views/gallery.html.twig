{# Dishes 'gallery' layout - the shared item gallery over the dish preview images (fancybox loaded
   by the list page, stage and binding via core assets/js/item-gallery.js). #}
{% set hasSlides = dishes|filter(item => item.previewImage)|length > 0 %}
{% embed '_components/item/gallery.html.twig' with {'empty': not hasSlides and not is_granted('ROLE_STEWARD')} %}
    {% block slides %}
        {% if is_granted('ROLE_STEWARD') %}
            <a href="{{ path('app_plugin_dishes_dish_add') }}" class="item-gallery-add has-background-link-light has-text-link" title="{{ 'dishes_views.title_add'|trans }}">
                <span class="icon"><i class="fa-solid fa-plus fa-lg"></i></span>
            </a>
        {% endif %}
        {% for item in dishes %}
            {% include '_components/item/styles/slide.html.twig' with {
                group: 'item-gallery-dish',
                image: item.previewImage,
                thumbSize: '400x400',
                bigSize: '1024x768',
                title: item.getTranslatedName(app.locale) ?: item.getAnyTranslatedName(),
                subtitle: item.origin,
                href: path('app_plugin_dishes_dish_show', {'id': item.id})
            } %}
        {% endfor %}
    {% endblock %}
{% endembed %}
