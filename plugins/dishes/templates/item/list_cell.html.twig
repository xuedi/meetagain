{# Dish cell for the shared item-list component. The dishes list page renders its own
   plugins/dishes/templates/views/* layouts instead; this remains for the provider contract. #}
{% set mode = viewMode ?? item_view_mode('dish').value %}
{% set showUrl = path('app_plugin_dishes_dish_show', {id: dish.id}) %}
{% set dishName = dish.getTranslatedName(app.locale) %}

{% if mode == 'row' %}
    {% include '_components/item/styles/row.html.twig' with {
        href: showUrl,
        image: dish.previewImage,
        imageSize: '100x100',
        title: dishName,
        subtitle: dish.origin
    } %}
{% elseif mode == 'grid' %}
    {% include '_components/item/styles/thumb.html.twig' with {
        href: showUrl,
        image: dish.previewImage,
        imageSize: '400x400',
        alt: dishName,
        ratio: 'square'
    } %}
{% elseif mode == 'gallery' %}
    {% include '_components/item/styles/slide.html.twig' with {
        group: 'item-gallery-dish',
        image: dish.previewImage,
        thumbSize: '400x400',
        title: dishName,
        subtitle: dish.origin,
        href: showUrl
    } %}
{% else %}
    {% include '_components/item/styles/portrait.html.twig' with {
        href: showUrl,
        image: dish.previewImage,
        imageSize: '350x263',
        title: dishName,
        subtitle: dish.origin
    } %}
{% endif %}
