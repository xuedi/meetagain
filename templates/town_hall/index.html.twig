{% extends 'base.html.twig' %}

{% block title %}{{ 'town_hall.page_title'|trans }}{% endblock %}

{% block body %}
<section class="section">
    <div class="container">
        {% include 'town_hall/_header.html.twig' with { active: 'dashboard' } %}
        {% include 'town_hall/_stats_strip.html.twig' with { stats: stats } %}

        <div class="columns">
            <div class="column is-8">
                {% include 'town_hall/_tile_conversations.html.twig' with { conversations: conversations } %}
                {% include 'town_hall/_tile_images.html.twig' with { images: images } %}
            </div>

            <div class="column is-4">
                {% if upcomingEvents|length > 0 %}
                    {% include 'town_hall/_tile_upcoming.html.twig' with { events: upcomingEvents } %}
                {% endif %}
                {% include 'town_hall/_tile_past.html.twig' with { events: pastEvents } %}
                {% include 'town_hall/_tile_members.html.twig' with { members: newMembers } %}
            </div>
        </div>
    </div>
</section>
{% endblock %}
