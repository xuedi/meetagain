{% extends 'town_hall/forum_base.html.twig' %}

{% block forum_main %}
    <div class="box">
        <h2 class="title is-5">{{ 'town_hall.forum_activity_heading'|trans }}</h2>

        {% if activity is empty %}
            <p class="has-text-grey">{{ 'town_hall.forum_activity_empty'|trans }}</p>
        {% else %}
            {% for row in activity %}
                <article class="media">
                    <div class="media-content">
                        <div class="content">
                            <p>
                                <strong>{{ row.comment.user ? row.comment.user.name : 'town_hall.deleted_user'|trans }}</strong>
                                <small class="has-text-grey">{{ row.comment.createdAt|date(get_date_format()) }}</small>
                                <br>
                                {{ row.comment.content|striptags|u.truncate(180, '...') }}
                                <br>
                                <a class="is-size-7" href="{{ path('app_townhall_forum_topic', { _locale: app.request.locale, topicId: row.topic.id }) }}">
                                    {% for node in row.topicPath %}{% if not loop.first %} &rsaquo; {% endif %}{{ node.title }}{% endfor %}
                                </a>
                            </p>
                        </div>
                    </div>
                </article>
            {% endfor %}
        {% endif %}
    </div>

    <article class="message is-info">
        <div class="message-body">{{ 'town_hall.forum_pick_hint'|trans }}</div>
    </article>
{% endblock %}
