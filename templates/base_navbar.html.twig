<nav class="navbar navbar-top is-fixed-top py-4" role="navigation" aria-label="{{ 'chrome.aria_main_navigation'|trans }}">
    <div class="container">
        <div class="navbar-brand">
            <a class="navbar-item" href="{{ path('app_default', {'_locale': current_locale()}) }}">
                {% set logo = site_logo() %}
                <img class="brand-logo" src="{{ logo.url }}"{% if logo.width %} width="{{ logo.width }}"{% endif %} height="{{ logo.height|default(40) }}" alt="{{ get_site_name() }}">
            </a>
            {% set notifications = is_granted('ROLE_USER') ? get_notifications() : null %}
            {% if notifications %}
                <a class="button is-small is-align-self-center is-hidden-desktop ml-auto mr-2 {% if notifications.totalCount > 0 %}is-danger{% else %}is-light{% endif %}"
                   href="{{ path('app_profile_notifications') }}"
                   aria-label="{{ 'profile_notifications.page_title'|trans }}">
                    <span class="icon is-small"><i class="fas fa-bell" aria-hidden="true"></i></span>
                    {% if notifications.totalCount > 0 %}<span>{{ notifications.totalCount }}</span>{% endif %}
                </a>
            {% endif %}
            <a role="button" class="navbar-burger{% if notifications %} ml-0{% endif %}" data-target="navBurgenMenu" aria-label="{{ 'chrome.aria_menu'|trans }}" aria-expanded="false">
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
                <span aria-hidden="true"></span>
            </a>
        </div>
        {% include 'base_navbar_burger.html.twig' %}
        <div id="navBarTop" class="navbar-menu">
            <div class="navbar-start">
                {% for pluginLink in get_leading_plugin_links() %}
                    <a class="navbar-item" href="{{ pluginLink.slug }}">{{ pluginLink.name | trans }}</a>
                {% endfor %}
                {% for menu in get_menu('top') %}
                    {% if menu.slug != 'index' %}
                        <a class="navbar-item" href="{{ menu.slug }}">{{ menu.name }}</a>
                    {% endif %}
                {% endfor %}
                {% for pluginLink in get_plugins_links() %}
                    <a class="navbar-item" href="{{ pluginLink.slug }}">{{ pluginLink.name | trans }}</a>
                {% endfor %}
            </div>
            <div class="navbar-end">
                {% if is_granted('ROLE_USER') %}
                    {% include 'base_navbar_menu.html.twig' %}
                {% else %}
                    {% set loginTarget = app.request.method == 'GET' and (app.request.attributes.get('_route') ?? '') not in ['app_login', 'app_register', 'app_reset', 'app_reset_password', 'app_register_confirm_email'] ? {'redirect': app.request.requestUri} : {} %}
                    <a class="navbar-item" href="{{ path('app_login', loginTarget) }}">{{ "chrome.menu_login" | trans }}</a>
                    {% include 'base_navbar_cookie.html.twig' %}
                {% endif %}
                {% include 'base_navbar_flags.html.twig' %}
            </div>
        </div>
    </div>
</nav>
