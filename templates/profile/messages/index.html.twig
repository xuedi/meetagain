{% extends 'base.html.twig' %}

{% block title %}{{ "profile_messages.section_heading"|trans }}{% endblock %}

{% block body %}

    {# Both layouts are in the page; a Symfony form renders its CSRF token only once, so the composer is captured once and printed in each. #}
    {% set composer %}{% if form %}{% include 'profile/messages/_composer.html.twig' %}{% endif %}{% endset %}
    {% set groupWindowSeconds = 300 %}
    {% if form and form.vars.submitted and not form.vars.valid %}<span hidden data-action="messages-form-error" data-action-field="{{ form.children|filter(child => (child.vars.errors ?? [])|length > 0)|keys|join(',') }}"></span>{% endif %}

    <section class="section is-hidden-touch">
        {% include 'profile/messages/chat_desktop.html.twig' %}
    </section>

    <section class="section is-hidden-desktop">
        {% include 'profile/messages/chat_mobile.html.twig' %}
    </section>

{% endblock %}

{% block javascripts %}
    {% if messages is not null %}
        <script src="{{ asset('js/messages.js') }}" defer></script>
    {% endif %}
{% endblock %}
