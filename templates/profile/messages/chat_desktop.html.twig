<div class="container">

    <div class="columns">
        <div class="column is-3">

            <div class="panel is-shadowless" data-conversations="desktop">

                <div class="panel-block">
                    <h1 class="title is-5">{{ 'profile_messages.section_heading'|trans }}</h1>
                </div>

                {% for conversation in conversations %}
                    <a class="panel-block is-block{% if conversationsId == conversation.user.id %} is-active{% endif %}"
                       href="{{ path('app_profile_messages', {'id': conversation.user.id}) }}"
                       {% if conversationsId == conversation.user.id %}aria-current="page"{% endif %}>
                        <div class="level">
                            <div class="level-left">
                                <div class="level-item">
                                    {% include '_components/image.html.twig' with {'image': conversation.user.image, 'size': '50x50'} %}
                                </div>
                                <div class="level-item">
                                    <div class="is-block has-text-left">
                                        <strong>{{ conversation.user.name }}</strong><br/>
                                        <small class="is-small">{{ conversation.lastMessage | time_diff }}</small>
                                    </div>
                                </div>
                            </div>
                            <div class="level-right">
                                <div class="content">
                                    {% if conversation.unread > 0 %}
                                        <span class="tag has-background-danger-light">{{ conversation.unread }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </a>
                {% endfor %}

            </div>
        </div>

        <div class="column is-9">

            {% if messages is null %}
                {% include 'profile/messages/_welcome.html.twig' %}
            {% else %}
                <div class="chat-layout" data-chat>
                    {% if conversationsId %}
                        {% include 'profile/messages/_block_toggle.html.twig' %}
                    {% endif %}

                    <div class="pr-3 messages-scroll" id="desktop-message-container">
                        {% set previous = null %}
                        {% for message in messages %}
                            {% set isOwn = user.id == message.sender.id %}
                            {% set isGrouped = previous is not null
                                and previous.sender.id == message.sender.id
                                and (message.createdAt|date('U') - previous.createdAt|date('U')) < groupWindowSeconds %}
                            <div class="message-row is-flex is-align-items-flex-end{% if isOwn %} is-flex-direction-row-reverse{% endif %}{% if isGrouped %} is-grouped{% endif %}">
                                <div class="message-avatar{% if isGrouped %} is-invisible{% endif %}">
                                    {% include '_components/image.html.twig' with {'image': message.sender.image, 'size': '50x50'} %}
                                </div>
                                {% include 'profile/messages/_message_bubble.html.twig' with {'message': message, 'isOwn': isOwn} only %}
                                {% if not isOwn and message.wasRead == false %}
                                    <span class="icon is-small has-text-danger is-align-self-center">
                                        <i class="fas fa-circle is-size-7" aria-hidden="true"></i>
                                    </span>
                                {% endif %}
                            </div>
                            {% set previous = message %}
                        {% endfor %}
                    </div>
                    <div>
                        {% include 'profile/messages/_composer_area.html.twig' %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

</div>
