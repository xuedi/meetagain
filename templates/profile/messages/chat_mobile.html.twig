<h1 class="title is-5">{{ 'profile_messages.section_heading'|trans }}</h1>
<div class="tabs is-boxed is-fullwidth is-small">
    <ul data-conversations="mobile">
        {% for conversation in conversations %}
            <li class="{% if conversationsId == conversation.user.id %}is-active{% endif %}">
                <a href="{{ path('app_profile_messages', {'id': conversation.user.id}) }}">
                            <span class="ml-2">
                                {{ conversation.user.name }}<br>
                                <small>{{ conversation.lastMessage | time_diff }}</small>
                            </span>
                </a>
            </li>
        {% endfor %}
    </ul>
</div>

{% if messages is null %}
    {% include 'profile/messages/_welcome.html.twig' %}
{% else %}
    <div class="chat-layout-mobile" data-chat>
        {% if conversationsId %}
            {% include 'profile/messages/_block_toggle.html.twig' %}
        {% endif %}

        <div id="mobile-message-container" class="messages-scroll">
            {% for message in messages %}
                <div class="message-row">
                    {% include 'profile/messages/_message_bubble.html.twig' with {'message': message, 'isOwn': user.id == message.sender.id, 'showName': true} only %}
                </div>
            {% endfor %}
        </div>
        <div>
            {% include 'profile/messages/_composer_area.html.twig' %}
        </div>
    </div>
{% endif %}
