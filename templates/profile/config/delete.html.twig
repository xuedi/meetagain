{% extends 'profile/config/_layout.html.twig' %}

{% block title %}{{ 'profile_config.menu_delete'|trans }}{% endblock %}

{% block config_main %}
    <div class="box">
        <h1 class="title is-5 has-text-danger">{{ 'profile_config.section_delete'|trans }}</h1>
        {% if deletionBlocker %}
            <div class="notification is-warning">{{ deletionBlocker|trans }}</div>
        {% else %}
            {{ form_start(form, {attr: {'data-action': 'profile-delete-submit'}}) }}
            {{ form_errors(form) }}

            <h2 class="title is-6 mb-1">{{ 'profile_config.delete_feedback_heading'|trans }}</h2>
            <p class="has-text-grey is-size-7 mb-4">{{ 'profile_config.delete_feedback_intro'|trans }}</p>
            {{ form_row(form.reason) }}
            {{ form_row(form.comment) }}

            <hr>

            {{ form_row(form.password) }}
            <div class="notification is-danger is-light">
                {{ form_row(form.acknowledge) }}
            </div>
            <button class="button is-danger">{{ 'profile_config.button_delete'|trans }}</button>
            {{ form_end(form) }}
        {% endif %}
    </div>
{% endblock %}

{% block config_info %}
    <div class="box has-background-info-light">
        <h2 class="title is-5">{{ 'profile_config.delete_info_heading'|trans }}</h2>
        <div class="content">
            <ol>
                <li>{{ 'profile_config.delete_info_closed'|trans }}</li>
                <li>{{ 'profile_config.delete_info_window'|trans({'%days%': erasureWindowDays, '%contact_link%': '<a href="' ~ path('app_contact') ~ '">' ~ ('profile_config.delete_info_contact_label'|trans) ~ '</a>'})|raw }}</li>
                <li>{{ 'profile_config.delete_info_erased'|trans({'%days%': erasureWindowDays}) }}</li>
                <li>{{ 'profile_config.delete_info_kept'|trans }}</li>
            </ol>
            <p>{{ 'profile_config.delete_info_export'|trans({'%export_link%': '<a href="' ~ path('app_profile_config_export_page') ~ '">' ~ ('profile_config.delete_info_export_label'|trans) ~ '</a>'})|raw }}</p>
        </div>
    </div>
{% endblock %}
