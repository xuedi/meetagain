{% extends 'profile/config/_layout.html.twig' %}

{% block title %}{{ 'profile_config.menu_password'|trans }}{% endblock %}

{% block config_main %}
    <div class="box">
        <h1 class="title is-5">{{ 'profile_config.section_change_password'|trans }}</h1>
        {{ form_start(form, {attr: {'data-action': 'profile-password-submit'}}) }}
        {% if form.vars.submitted and not form.vars.valid %}<span hidden data-action="profile-password-error" data-action-field="{{ form.children|filter(child => (child.vars.errors ?? [])|length > 0)|keys|join(',') }}"></span>{% endif %}
        {{ form_errors(form) }}

        {{ form_row(form.oldPassword) }}
        {{ form_row(form.newPassword) }}

        <button class="button is-link">{{ 'profile_config.button_change_password'|trans }}</button>
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block config_info %}
    <div class="box has-background-info-light">
        <h2 class="title is-5">{{ 'profile_config.info_password_heading'|trans }}</h2>
        <div class="content">
            <ul>
                <li>{{ 'profile_config.info_password_unique'|trans }}</li>
                <li>{{ 'profile_config.info_password_sessions'|trans }}</li>
            </ul>
            <p>{{ 'profile_config.password_reset_hint'|trans({'%reset_link%': '<a href="' ~ path('app_reset') ~ '">' ~ ('profile_config.password_reset_link_label'|trans) ~ '</a>'})|raw }}</p>
        </div>
    </div>
{% endblock %}
