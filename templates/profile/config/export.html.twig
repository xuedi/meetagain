{% extends 'profile/config/_layout.html.twig' %}

{% block title %}{{ 'profile_config.menu_export'|trans }}{% endblock %}

{% block config_main %}
    <div class="box">
        <h1 class="title is-5">{{ 'profile_config.section_export'|trans }}</h1>
        <form method="post" action="{{ path('app_profile_config_export') }}">
            <input type="hidden" name="_token" value="{{ csrf_token('app_profile_config_export' ~ user.id) }}">
            <div class="field">
                <label class="label" for="export_password">{{ 'profile_config.form_label_password'|trans }}</label>
                <div class="control">
                    <input class="input" type="password" id="export_password" name="password" autocomplete="current-password" required>
                </div>
            </div>
            <button class="button is-link">{{ 'profile_config.button_export'|trans }}</button>
        </form>
    </div>
{% endblock %}

{% block config_info %}
    <div class="box has-background-info-light">
        <h2 class="title is-5">{{ 'profile_config.info_export_heading'|trans }}</h2>
        <div class="content">
            <p>{{ 'profile_config.export_intro'|trans }}</p>
            <ul>
                <li>{{ 'profile_config.info_export_password'|trans }}</li>
                <li>{{ 'profile_config.info_export_not_stored'|trans }}</li>
            </ul>
        </div>
    </div>
{% endblock %}
