{% extends 'base.html.twig' %}

{% block title %}{{ ({suggest: 'contribution.suggest_page_title', correct_tags: 'item.tag_page_title'}[pane] ?? 'contribution.correct_page_title')|trans({'%type%': typeLabelKey|default('')|trans}) }}{% endblock %}

{% block body %}

    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-two-thirds">
                    {% if pane == 'correct' %}
                        {{ include('contribution/_correct_form.html.twig') }}
                    {% elseif pane == 'correct_tags' %}
                        {{ include('contribution/_tag_form.html.twig') }}
                    {% else %}
                        {{ include('contribution/_suggest_form.html.twig') }}
                    {% endif %}
                </div>
            </div>
        </div>
    </section>

{% endblock %}
