<h1 class="title is-4">{{ 'contribution.correct_page_title'|trans }}</h1>
<p class="subtitle is-6">{{ draft.introKey|trans({'%name%': draft.label}) }}</p>

{{ form_start(form) }}
<div class="box">
    {{ form_widget(form) }}
    <div class="field mt-5">
        <div class="control">
            <button type="submit" class="button is-primary">
                {{ 'contribution.button_correct'|trans }}
            </button>
        </div>
    </div>
</div>
{{ form_end(form) }}

{% if pendingProposals is not empty %}
    <h2 class="title is-5">{{ 'contribution.pending_proposals_heading'|trans }}</h2>
    {% for card in pendingProposals %}
        {{ include('@Proposal/change/_card.html.twig', {
            card: card|merge({isProposer: card.proposal.proposerId == app.user.id}),
            canReview: false,
        }) }}
    {% endfor %}
{% endif %}
