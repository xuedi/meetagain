{#
    Comment Section -- Discussion list plus the add-comment form for one comment target

    Renders every comment on a target (newest first) followed by the add form, so any page
    can host a discussion with the single Twig call comment_section(targetType, targetId).
    The form is a plain POST to the generic comment route; it only appears for a signed-in
    visitor the target's provider allows to comment.

    Used in:    App\Twig\CommentExtension::section, called as comment_section() from page templates
    Parameters:
        - targetType (string, required) -- comment target key, e.g. 'event'
        - targetId   (int, required)    -- id of the target row
        - comments   (array, required)  -- Comment entities, newest first
        - canComment (bool, required)   -- provider verdict on adding a comment
        - maxLength  (int, required)    -- character cap enforced server-side
    Depends on: _components/comment/entry.html.twig; assets/js/event-details.js (#replyInput)
#}
<h2 class="title is-4">{{ 'comment.heading'|trans }}</h2>
<div class="columns">
    <div class="column is-four-fifths">
        {% for comment in comments %}
            {% include '_components/comment/entry.html.twig' with {'comment': comment, 'targetType': targetType, 'targetId': targetId} %}
        {% endfor %}
        {% if canComment and is_granted('ROLE_USER') %}
            <form method="post" action="{{ path('app_comment_create', {'targetType': targetType, 'targetId': targetId}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('app_comment_create' ~ targetType ~ targetId) }}">
                <div class="field">
                    <div class="control">
                        <textarea class="textarea" id="replyInput" name="content" rows="3" maxlength="{{ maxLength }}"
                                  placeholder="{{ 'comment.input_placeholder'|trans }}" required></textarea>
                    </div>
                </div>
                <button class="button is-link">{{ 'comment.button_add'|trans }}</button>
            </form>
        {% endif %}
    </div>
</div>
