{#
    Item List Sidebar - the shared side column of an item-list page

    Three stacked boxes for any item type: the view-mode switcher, the tag filter (which
    renders nothing of its own when the type defines no vocabulary), and an "about this list" box
    carrying a plugin-supplied blurb and - for a steward looking at a type with no vocabulary yet -
    a hint pointing at the tag page. The entry count lives in the result header above
    the list, not here. Everything except the blurb key is read from the core item Twig functions,
    so a page adopts the whole column by naming its item type.

    Used in:    _components/item/list_layout.html.twig
    Parameters:
        - itemType    (string, required)        -- registry key of the item type (e.g. 'film')
        - modes       (list<string>, optional)  -- view-mode values to offer; default: all four
        - defaultMode (string, optional)        -- mode shown before the visitor picks one; default: 'list'
        - infoKey     (string, optional)        -- translation key of the blurb;
                                                   default: 'item.sidebar_info_default'
    Depends on: _components/item/view_switcher.html.twig, _components/item/tag_filter.html.twig;
                item_tag_choices() (ItemTagExtension); the app_item_tags route
#}
<div class="box mb-4">
    <p class="heading">{{ 'item.sidebar_view_heading'|trans }}</p>
    {% include '_components/item/view_switcher.html.twig' with {
        'itemType': itemType,
        'modes': modes|default([]),
        'defaultMode': defaultMode|default(null)
    } only %}
</div>

<div data-item-filter>
    {% include '_components/item/tag_filter.html.twig' with {'itemType': itemType} only %}
</div>

<div class="box">
    <p class="heading">{{ 'item.sidebar_about_heading'|trans }}</p>
    <p class="is-size-7 has-text-grey">{{ (infoKey|default('item.sidebar_info_default'))|trans }}</p>
    {% if is_granted('ROLE_STEWARD') and item_tag_choices(itemType) is empty %}
        <p class="is-size-7 has-text-grey mt-3">
            {{ 'item.sidebar_tag_hint'|trans }}
            <a href="{{ path('app_item_tags', {itemType: itemType}) }}">{{ 'item.sidebar_tag_settings_link'|trans }}</a>
        </p>
    {% endif %}
</div>
