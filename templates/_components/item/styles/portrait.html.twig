{#
    Item tile style: portrait - a card with a title and an optional centered subtitle under an
    image cropped to the aspect ratio of the requested thumbnail size. For posters and covers
    (e.g. films, books), where source artwork ratios vary by a few percent and a ragged grid
    reads as broken. Width comes from the wrapping column.

    Used in:    plugin item cell templates (e.g. plugins/films/templates/item/list_cell.html.twig)
    Parameters:
        - href      (string, required)     -- link target for the whole tile
        - title     (string, required)     -- primary label (single line, ellipsised)
        - image     (Image|null, optional) -- thumbnail; null shows the placeholder
        - imageSize (string, optional)     -- thumbnail dimensions 'WxH'; default '200x300';
                                              also sets the tile's aspect ratio
        - alt       (string, optional)     -- image alt; default: title
        - subtitle  (string, optional)     -- centered secondary text (e.g. year, author)
    Depends on: _components/image.html.twig; the .item-portrait rules in custom.scss
#}
{% set portraitSize = imageSize|default('200x300') %}
{% set portraitRatio = portraitSize|split('x') %}
<a href="{{ href }}" class="is-block item-portrait">
    <div class="card">
        <div class="card-image">
            <figure class="image item-portrait__media" style="aspect-ratio: {{ portraitRatio[0] }} / {{ portraitRatio[1] }};">
                {% include '_components/image.html.twig' with {'image': image|default(null), 'size': portraitSize, 'alt': alt|default(title)} %}
            </figure>
        </div>
        <div class="card-content p-2 has-text-centered">
            <p class="is-size-7 has-text-dark item-portrait__title">{{ title }}</p>
            {% if subtitle is defined and subtitle %}<p class="is-size-7 has-text-grey">{{ subtitle }}</p>{% endif %}
        </div>
    </div>
</a>
