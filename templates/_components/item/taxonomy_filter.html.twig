{#
    Item Facet Filter -- one chip row per facet group for narrowing an item list

    Renders the type's scope-resolved category and tag vocabularies as rows of Bulma tag chips:
    category chips are single-select (clicking the active one clears it), tag chips toggle. Every
    chip is a real link to a facet URL, so the box narrows the list with JavaScript disabled.
    Each option carries the number of entries it would yield against the current selection and
    renders as a dimmed span instead of a link when that number is zero. Renders nothing when the
    type enables no categories or tags.

    The header row carries a pencil to the central taxonomy page for any logged-in visitor, with the
    pending-proposal count as a badge for reviewers. It lives inside the swapped fragment, so it
    survives a facet click.

    Used in:    _components/item/sidebar.html.twig, App\Controller\ItemController::listFragment
    Parameters:
        - itemType (string, required) -- registry key of the item type (e.g. 'dish')
    Depends on: item_taxonomy_category_choices(), item_taxonomy_tag_choices(), item_facet_current(),
                item_facet_url(), item_facet_counts(), item_taxonomy_target()
                (ItemTaxonomyExtension); pending_change_proposals() (ChangeProposalExtension);
                item_list_url() (ItemListExtension); the app_item_taxonomy route;
                assets/js/item-list.js for the swap and the mobile collapse
#}
{% import _self as facet %}

{% macro chip(url, label, count, active, extra) %}
    {% set classes = 'tag' ~ (active ? ' is-link' : ' is-light') ~ (extra ? ' item-facet-extra' : '') %}
    {% if count is same as(0) and not active %}
        <span class="{{ classes }} has-text-grey-light" title="{{ 'item.facet_zero_hint'|trans }}">{{ label }}<span class="ml-1">0</span></span>
    {% else %}
        <a href="{{ url }}" class="{{ classes }}" rel="nofollow" data-item-facet>{{ label }}{% if count is not null %}<span class="ml-1 {{ active ? '' : 'has-text-grey' }}">{{ count }}</span>{% endif %}</a>
    {% endif %}
{% endmacro %}

{% set categories = item_taxonomy_category_choices(itemType) %}
{% set tags = item_taxonomy_tag_choices(itemType) %}
{% if categories is not empty or tags is not empty %}
    {% set selection = item_facet_current() %}
    {% set counts = item_facet_counts(itemType) %}
    {% set baseUrl = item_list_url(itemType) %}
    {% set activeCount = selection.count() %}
    {% set visibleChips = 12 %}
    <div class="box taxonomy-filter mb-4">
        <div class="is-flex is-justify-content-space-between is-align-items-center mb-2">
            <p class="heading mb-0">{{ 'item.facet_heading'|trans }}</p>
            <span class="is-flex is-align-items-center" style="gap: 0.5rem;">
                {% if activeCount > 0 %}
                    <a href="{{ baseUrl }}" class="is-size-7" rel="nofollow" data-item-facet>{{ 'item.facet_clear'|trans }}</a>
                {% endif %}
                {% if is_granted('ROLE_USER') %}
                    {% set target = is_granted('ROLE_STEWARD') ? item_taxonomy_target(itemType) : null %}
                    {% set pendingCount = target ? pending_change_proposals(target.type, target.id) : 0 %}
                    <a href="{{ path('app_item_taxonomy', {itemType: itemType}) }}"
                       class="is-size-7" rel="nofollow" title="{{ 'item.taxonomy_edit_link'|trans }}">
                        <span class="icon is-small"><i class="fa-solid fa-pen-to-square"></i></span>
                        {% if pendingCount > 0 %}<span class="tag is-warning">{{ pendingCount }}</span>{% endif %}
                    </a>
                {% endif %}
            </span>
        </div>

        <button type="button" class="button is-small is-fullwidth mb-2 is-hidden-tablet is-hidden" data-item-facet-toggle>
            <span class="icon"><i class="fa-solid fa-filter"></i></span>
            <span>{{ 'item.facet_toggle'|trans({'%count%': activeCount}) }}</span>
        </button>

        <div data-item-facet-panel>
            {% if categories is not empty %}
                <div class="field">
                    <p class="label is-small mb-1">{{ 'item.facet_categories'|trans }}</p>
                    <div class="tags">
                        {% for id, label in categories %}
                            {{ facet.chip(
                                item_facet_url(baseUrl, selection.withCategory(selection.category is same as(id) ? null : id)),
                                label,
                                counts ? counts.forCategory(id) : null,
                                selection.category is same as(id),
                                loop.index0 >= visibleChips
                            ) }}
                        {% endfor %}
                        {% if categories|length > visibleChips %}
                            <button type="button" class="tag is-white has-text-link is-hidden" data-item-facet-more>{{ 'item.facet_show_all'|trans({'%count%': categories|length}) }}</button>
                        {% endif %}
                    </div>
                </div>
            {% endif %}

            {% if tags is not empty %}
                <div class="field">
                    <p class="label is-small mb-1">{{ 'item.facet_tags'|trans }}</p>
                    <div class="tags">
                        {% for id, label in tags %}
                            {{ facet.chip(
                                item_facet_url(baseUrl, selection.withTagToggled(id)),
                                label,
                                counts ? counts.forTag(id) : null,
                                selection.hasTag(id),
                                loop.index0 >= visibleChips
                            ) }}
                        {% endfor %}
                        {% if tags|length > visibleChips %}
                            <button type="button" class="tag is-white has-text-link is-hidden" data-item-facet-more>{{ 'item.facet_show_all'|trans({'%count%': tags|length}) }}</button>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endif %}
