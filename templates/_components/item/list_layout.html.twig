{#
    Item List Layout - two-column wrapper pairing a plugin's list body with the shared sidebar

    Owns the responsive wrapper of every item-list page: core renders the sidebar in one column and
    the type's list body in the other, so a page that needs nothing extra includes this template and
    names its item type. The sidebar column comes first in the DOM so it stacks above the list below
    769px and is moved to the right above it by the .item-list-layout rules in custom.scss - which
    also keeps keyboard and screen reader order at "filters before results" on every viewport. A
    page needing one more box in the column appends it through {% block item_sidebar_extra %}; one
    needing markup around the list overrides {% block item_list_main %} and calls item_list_body()
    inside it. The scope attributes are the hooks assets/js/item-list.js swaps against.

    Used in:    item-list pages of the films / books / dishes / glossary plugins
    Parameters:
        - itemType  (string, required)       -- registry key of the item type (e.g. 'film')
        - modes     (list<string>, optional) -- view-mode values to offer; default: all four
        - infoKey   (string, optional)       -- translation key of the sidebar blurb;
                                                default: 'item.sidebar_info_default'
    Blocks:
        - item_list_main     -- the swappable list region; defaults to item_list_body(itemType)
        - item_sidebar_extra -- optional extra box below the shared sidebar boxes
    Depends on: _components/item/sidebar.html.twig; item_list_body() (ItemListExtension);
                the app_item_list_fragment route
#}
<div class="columns item-list-layout"
     data-item-list-scope="{{ itemType }}"
     data-item-list-fragment="{{ path('app_item_list_fragment', {'itemType': itemType}) }}">
    <div class="column is-narrow item-list-sidebar">
        {% include '_components/item/sidebar.html.twig' with {
            'itemType': itemType,
            'modes': modes|default([]),
            'infoKey': infoKey|default('item.sidebar_info_default')
        } only %}
        {% block item_sidebar_extra %}{% endblock %}
    </div>
    <div class="column item-list-main">
        {% block item_list_main %}{{ item_list_body(itemType) }}{% endblock %}
    </div>
</div>
