<div id="navBurgenMenu" class="navbar-menu is-hidden-desktop">

    <div class="navbar-start">
        <a class="navbar-item" href="{{ path('app_default') }}">{{ "chrome.menu_default" | trans }}</a>
        {% for pluginLink in get_leading_plugin_links() %}
            <a class="navbar-item" href="{{ pluginLink.slug }}">{{ pluginLink.name | trans }}</a>
        {% endfor %}
        {% for menu in get_menu('top') %}
            {% if menu.slug != 'index' %}
                <a class="navbar-item" href="{{ menu.slug }}">{{ menu.name }}</a>
            {% endif %}
        {% endfor %}
        {% for pluginLink in get_plugins_links() %}
            <a class="navbar-item" href="{{ pluginLink.slug }}">{{ pluginLink.name | trans }}</a>
        {% endfor %}

        <div class="navbar-item">
            <details data-action="nav-more-open" class="navbar-burger-submenu">
                <summary>{{ 'chrome.menu_more'|trans }}</summary>
                <aside class="menu pl-3 mt-2">
                    <p class="menu-label">{{ get_footer_column_title('col2') ?: ('chrome.footer_col_platform' | trans) }}</p>
                    <ul class="menu-list">
                        {% for menu in get_menu('col2') %}
                            {% if menu.slug != 'index' %}
                                <li><a href="{{ menu.slug }}">{{ menu.name }}</a></li>
                            {% endif %}
                        {% endfor %}
                        {% for link in get_plugin_footer_links('col2') %}
                            <li><a href="{{ link.slug }}"{% if link.slug starts with 'http' %} target="_blank" rel="noopener noreferrer"{% endif %}>{{ link.name | trans }}</a></li>
                        {% endfor %}
                    </ul>
                    <p class="menu-label">{{ get_footer_column_title('col4') ?: ('chrome.footer_col_legal' | trans) }}</p>
                    <ul class="menu-list">
                        {% for menu in get_menu('col4') %}
                            {% if menu.slug != 'index' %}
                                <li><a href="{{ menu.slug }}">{{ menu.name }}</a></li>
                            {% endif %}
                        {% endfor %}
                        {% if has_image_attributions() %}
                            <li><a href="{{ path('app_attributions') }}">{{ 'chrome.footer_attributions' | trans }}</a></li>
                        {% endif %}
                    </ul>
                </aside>
            </details>
        </div>

        {% if is_granted('ROLE_USER') %}
            <hr class="dropdown-divider"/>
            <div class="navbar-item">
                <aside class="menu">
                    <p class="menu-label">{{ 'chrome.burger_logged_in_label'|trans({'%name%': app.user.name}) }}</p>
                    <ul class="menu-list pl-3">
                        <li><a href="{{ path('app_profile') }}">{{ "chrome.menu_profile_view_profile" | trans }}</a></li>
                        <li><a href="{{ path('app_profile_messages') }}">{{ "chrome.menu_profile_messages" | trans }}</a></li>
                        <li><a href="{{ path('app_profile_social') }}">{{ "chrome.menu_profile_social" | trans }}</a></li>
                        <li><a href="{{ path('app_profile_config') }}">{{ "chrome.menu_profile_config" | trans }}</a></li>
                    </ul>
                </aside>
            </div>
        {% endif %}

        <hr class="dropdown-divider"/>
        {% if is_granted('ROLE_USER') %}
            <form action="{{ path('app_security_logout') }}" method="post" class="is-contents">
                <input type="hidden" name="_token" value="{{ csrf_token('logout') }}">
                <button data-action="nav-logout-click" data-action-place="burger" type="submit" class="navbar-item LinkLikeButton is-column-fill">
                    <span class="icon mr-2"><i class="fa fa-sign-out"></i></span>
                    {{ "chrome.menu_profile_logout" | trans }}
                </button>
            </form>
        {% else %}
            <a data-action="nav-login-click" data-action-place="burger" class="navbar-item" href="{{ path('app_login') }}">
                <span class="icon mr-2"><i class="fa fa-sign-in"></i></span>
                {{ "chrome.menu_login" | trans }}
            </a>
            <a class="navbar-item" href="{{ path('app_cookie') }}">
                <span class="icon mr-2"><i class="fa fa-cookie-bite"></i></span>
                {{ "cookie.page_title" | trans }}
            </a>
        {% endif %}

        {% set currentLocale = app.request.locale %}
        {% set altLanguages = get_alternative_languages()|filter((link, code) => code != currentLocale) %}
        {% if altLanguages|length > 0 %}
            <hr class="dropdown-divider"/>
            <div class="navbar-item">
                <details data-action="nav-language-open" data-action-place="burger" class="navbar-burger-submenu" data-language-switcher>
                    <summary aria-label="{{ 'chrome.aria_select_language'|trans }}">
                        <span class="is-inline-flex is-align-items-center">
                            <figure class="flag-icon mr-3">
                                <img class="is-flag" src="{{ asset('images/flags/' ~ currentLocale ~ '.svg') }}" width="32" height="24" alt=""/>
                            </figure>
                            <span>{{ ('language_' ~ currentLocale)|trans({}, 'messages', currentLocale) }}</span>
                        </span>
                    </summary>
                    <aside class="menu mt-2">
                        <ul class="menu-list">
                            {% for code, link in altLanguages %}
                                <li>
                                    <a data-action="nav-language-click" data-action-place="burger" class="is-flex is-align-items-center" href="{{ link }}" hreflang="{{ code }}">
                                        <figure class="flag-icon mr-3">
                                            <img class="is-flag" src="{{ asset('images/flags/' ~ code ~ '.svg') }}" width="32" height="24" alt=""/>
                                        </figure>
                                        <span lang="{{ code }}">{{ ('language_' ~ code)|trans({}, 'messages', code) }}</span>
                                        <span class="ml-2 has-text-grey">({{ ('language_' ~ code)|trans }})</span>
                                    </a>
                                </li>
                            {% endfor %}
                        </ul>
                    </aside>
                </details>
            </div>
        {% endif %}

    </div>

</div>
