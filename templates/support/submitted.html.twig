{% extends 'base.html.twig' %}

{% block title %}{{ 'support.confirm_title'|trans }}{% endblock %}
{% block meta_robots %}<meta name="robots" content="noindex,nofollow">{% endblock %}

{% block body %}

    <section class="section">
        <div class="container">
            <div class="columns is-centered mt-5">
                <div class="column is-6-tablet is-5-desktop">

                    <h1 class="title is-5">{{ 'support.confirm_title'|trans }}</h1>

                    <p>{{ 'support.confirm_member_body'|trans }}</p>
                    <a class="button is-primary mt-4" href="{{ path('app_profile_messages') }}">{{ 'support.confirm_member_inbox'|trans }}</a>

                    <p class="is-size-7 has-text-grey mt-4">{{ 'support.response_time'|trans }}</p>
                    <p class="mt-4"><a href="{{ path('app_frontpage') }}">{{ 'support.confirm_back'|trans }}</a></p>

                </div>
            </div>
        </div>
    </section>

{% endblock %}
