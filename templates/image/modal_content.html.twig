{% set selectableGallery = (imageUploadGallery is defined ? imageUploadGallery : [])|filter(item => item.link is not null) %}
{% if selectableGallery is not empty %}
    <h1 class="title is-4">{{ 'shared.image_modal_choose_existing_heading'|trans }}</h1>
    <div class="mb-5">
        {% for galleryItem in selectableGallery %}
            <a href="{{ galleryItem.link }}"
               class="image-item"
               data-post
               data-csrf-token="{{ csrf_token('app_replace_image_select' ~ id) }}">
                {% include '_components/image.html.twig' with {'image': galleryItem.image, 'size': '80x80'} %}
            </a>
        {% endfor %}
    </div>
{% endif %}

<div class="title is-4">{{ 'shared.image_modal_upload_heading'|trans }}</div>
{% if uploadForm is defined %}
    {{ form_start(uploadForm) }}
    {{ form_row(uploadForm.files) }}
    <div class="field">
        <button type="submit" class="button is-link">{{ 'shared.image_modal_upload_button'|trans }}</button>
    </div>
    {{ form_end(uploadForm) }}
{% else %}
    {{ form_start(replaceForm, {attr: {'data-submit-on-change': ''}}) }}
    <div class="file is-link">
        <label class="file-label">
            <input
                class="file-input"
                type="file"
                id="{{ replaceForm.newImage.vars.id }}"
                name="{{ field_name(replaceForm.newImage) }}"
            />
            <span class="file-cta">
                <span class="file-icon">
                    <i class="fas fa-upload"></i>
                </span>
                <span class="file-label">{{ 'shared.image_modal_upload_label'|trans }}</span>
            </span>
        </label>
    </div>
    {{ form_end(replaceForm) }}
    <p class="mt-3">
        {{ 'shared.image_modal_upload_hint'|trans }}
    </p>
{% endif %}
