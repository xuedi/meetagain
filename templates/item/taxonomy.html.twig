{#
    Item Taxonomy page - the one place a type's category and tag vocabulary is edited

    Reached from the pencil in the list page's filter box. A manager of the scope this request
    resolves to gets the definition editor (one label column per admin language, collection rows);
    everyone else gets the single-locale suggestion form, whose submit becomes a change proposal.
    Both render the vocabulary grouped exactly as the manager defined it - ungrouped entries first,
    then one indented block per display group, a sub-tag indented under the tag it hangs from. Where
    the depth limit still allows one, the suggestion form offers a field for a new sub-tag. Pending
    proposals for this vocabulary are listed below either form.

    Rendered by: App\Controller\ItemTaxonomyController
    Parameters:
        - itemType, typeLabelKey (string)
        - axes (list) -- per supported axis: key, headingKey, emptyKey, enabled, usage (id => count),
                         groups (list of {label: ?string, rows: list of {id, label, depth, canAddChild}})
        - disabledAxisKeys (list<string>), targetType (string), targetId (?int)
        - form (?FormView), canManage (bool), canSuggest (bool), pending (list)
    Depends on: js/admin/collection.js, js/admin/taxonomy-definitions.js; item_list_url()
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'item.taxonomy_page_title'|trans({'%type%': typeLabelKey|trans}) }}{% endblock %}

{% block body %}

    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-two-thirds">

                    <h1 class="title is-4">{{ 'item.taxonomy_page_title'|trans({'%type%': typeLabelKey|trans}) }}</h1>
                    <p class="subtitle is-6 has-text-grey">{{ 'item.taxonomy_page_intro'|trans }}</p>

                    {% for headingKey in disabledAxisKeys %}
                        <p class="notification is-warning is-light is-size-7">
                            {{ 'item.taxonomy_disabled_hint'|trans({'%axis%': headingKey|trans}) }}
                        </p>
                    {% endfor %}

                    {% if canManage %}
                        <div class="box">
                            {{ form_start(form) }}
                            {{ form_widget(form) }}
                            <div class="has-text-right">
                                <a href="{{ item_list_url(itemType) }}" class="button">{{ 'global.button_cancel'|trans }}</a>
                                <button type="submit" class="button is-link">{{ 'global.button_save'|trans }}</button>
                            </div>
                            {{ form_end(form) }}
                        </div>
                    {% elseif canSuggest %}
                        <form method="post" class="box">
                            <input type="hidden" name="_token" value="{{ csrf_token('item_taxonomy_suggest') }}">
                            {% for axis in axes|filter(axis => axis.enabled) %}
                                <p class="label is-small mb-2">{{ axis.headingKey|trans }}</p>
                                {% for group in axis.groups %}
                                    {% if group.label %}
                                        <p class="is-size-7 has-text-weight-semibold mb-1 mt-3">{{ group.label }}</p>
                                    {% endif %}
                                    <div class="{{ group.label ? 'ml-4' }}">
                                        {% for row in group.rows %}
                                            <div class="field has-addons" style="padding-left: {{ (row.depth - 1) * 1.5 }}rem;">
                                                <div class="control is-expanded">
                                                    <input class="input" type="text" name="suggest[{{ axis.key }}][edit][{{ row.id }}]" value="{{ row.label }}">
                                                </div>
                                                {% if axis.usage[row.id]|default(0) > 0 %}
                                                    <div class="control">
                                                        <span class="button is-static" title="{{ 'item.taxonomy_usage_hint'|trans({'%count%': axis.usage[row.id]}) }}">{{ axis.usage[row.id] }}</span>
                                                    </div>
                                                {% endif %}
                                            </div>
                                            {% if row.canAddChild %}
                                                <div class="field" style="padding-left: {{ row.depth * 1.5 }}rem;">
                                                    <div class="control">
                                                        <input class="input is-small" type="text" name="suggest[{{ axis.key }}][addBelow][{{ row.id }}][]"
                                                               placeholder="{{ 'item.taxonomy_suggest_add_child_placeholder'|trans({'%parent%': row.label}) }}">
                                                    </div>
                                                </div>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                {% endfor %}
                                <div class="field">
                                    <div class="control">
                                        <input class="input" type="text" name="suggest[{{ axis.key }}][add][]"
                                               placeholder="{{ 'item.taxonomy_suggest_add_placeholder'|trans }}">
                                    </div>
                                </div>
                            {% endfor %}
                            <p class="help mb-4">{{ 'item.taxonomy_suggest_hint'|trans }}</p>
                            <div class="has-text-right">
                                <a href="{{ item_list_url(itemType) }}" class="button">{{ 'global.button_cancel'|trans }}</a>
                                <button type="submit" class="button is-link">{{ 'item.taxonomy_button_suggest'|trans }}</button>
                            </div>
                        </form>
                    {% else %}
                        <div class="box">
                            {% for axis in axes|filter(axis => axis.enabled) %}
                                <p class="label is-small mb-2">{{ axis.headingKey|trans }}</p>
                                {% for group in axis.groups %}
                                    {% if group.label %}
                                        <p class="is-size-7 has-text-weight-semibold mb-1 mt-3">{{ group.label }}</p>
                                    {% endif %}
                                    <div class="tags{{ group.label ? ' ml-4' }}">
                                        {% for row in group.rows %}
                                            <span class="tag is-light" style="margin-left: {{ (row.depth - 1) * 1.5 }}rem;">{{ row.label }}</span>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <span class="has-text-grey is-size-7">{{ axis.emptyKey|trans }}</span>
                                {% endfor %}
                            {% endfor %}
                        </div>
                    {% endif %}

                    {% if pending is not empty %}
                        <h2 class="title is-5">{{ 'item.taxonomy_pending_heading'|trans }}</h2>
                        {% for card in pending %}
                            <div class="box has-background-info-light">
                                <p class="mb-2">
                                    <b>{{ card.proposal.proposedBy.name }}</b>
                                    <span class="has-text-grey">{{ card.proposal.createdAt|time_diff }}</span>
                                </p>
                                <ul>
                                    {% for row in card.rows %}
                                        <li>
                                            <b>{{ row.label }}</b>:
                                            <span class="has-text-grey">{{ row.before|default('-') }}</span>
                                            <i class="fas fa-arrow-right is-size-7"></i>
                                            {{ row.after|default('-') }}
                                        </li>
                                    {% endfor %}
                                </ul>
                                {% if canManage or card.isProposer %}
                                    <a class="is-size-7" href="{{ path('app_review_proposals', {targetType: targetType, targetId: targetId}) }}">
                                        {{ 'item.taxonomy_pending_review_link'|trans }}
                                    </a>
                                {% endif %}
                            </div>
                        {% endfor %}
                    {% endif %}

                    <a href="{{ item_list_url(itemType) }}" class="is-size-7">{{ 'item.taxonomy_back_to_list'|trans }}</a>

                </div>
            </div>
        </div>
    </section>

{% endblock %}

{% block javascripts %}
    {% if canManage %}
        <script src="{{ asset('js/admin/collection.js') }}" defer></script>
        <script src="{{ asset('js/admin/taxonomy-definitions.js') }}" defer></script>
    {% endif %}
{% endblock %}
