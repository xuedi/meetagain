{#
    Item Tags page - the one place a type's tag vocabulary is edited

    Steward-only, reached from the pencil in the list page's filter box. One label column per admin
    language, collection rows, the vocabulary in tree order with a sub-tag indented under the tag it
    hangs from. Pending proposals for this vocabulary are listed below the form; a member raises
    those from the contribution hub's tag pane (contribution/_tag_form.html.twig).

    Rendered by: App\Controller\ItemTagController
    Parameters:
        - itemType, typeLabelKey (string)
        - targetType (string)
        - form (FormView), pending (list)
    Depends on: js/admin/collection.js, js/admin/item-tags.js; item_list_url()
#}
{% extends 'base.html.twig' %}

{% block title %}{{ 'item.tag_page_title'|trans({'%type%': typeLabelKey|trans}) }}{% endblock %}

{% block body %}

    <section class="section">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-two-thirds">

                    <h1 class="title is-4">{{ 'item.tag_page_title'|trans({'%type%': typeLabelKey|trans}) }}</h1>
                    <p class="subtitle is-6 has-text-grey">{{ 'item.tag_page_intro'|trans }}</p>

                    <div class="box">
                        {{ form_start(form) }}
                        <p class="help mb-2">{{ 'item.tag_tree_help'|trans }}</p>
                        {{ form_widget(form) }}
                        <div class="has-text-right">
                            <a href="{{ item_list_url(itemType) }}" class="button">{{ 'global.button_cancel'|trans }}</a>
                            <button type="submit" class="button is-link">{{ 'global.button_save'|trans }}</button>
                        </div>
                        {{ form_end(form) }}
                    </div>

                    {% if pending is not empty %}
                        <h2 class="title is-5">{{ 'item.tag_pending_heading'|trans }}</h2>
                        {% for card in pending %}
                            <div class="box has-background-info-light">
                                <p class="mb-2">
                                    <b>{{ card.proposal.proposerName }}</b>
                                    <span class="has-text-grey">{{ card.proposal.createdAt|time_diff }}</span>
                                </p>
                                <ul>
                                    {% for row in card.rows %}
                                        <li>
                                            <b>{{ row.label }}</b>:
                                            <span class="has-text-grey">{{ row.before|default('-') }}</span>
                                            <i class="fas fa-arrow-right is-size-7"></i>
                                            {{ row.after|default('-') }}
                                        </li>
                                    {% endfor %}
                                </ul>
                                <a class="is-size-7" href="{{ path('app_review_proposals', {targetType: targetType, targetId: card.targetId}) }}">
                                    {{ 'item.tag_pending_review_link'|trans }}
                                </a>
                            </div>
                        {% endfor %}
                    {% endif %}

                    <a href="{{ item_list_url(itemType) }}" class="is-size-7">{{ 'item.tag_back_to_list'|trans }}</a>

                </div>
            </div>
        </div>
    </section>

{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/admin/collection.js') }}" defer></script>
    <script src="{{ asset('js/admin/item-tags.js') }}" defer></script>
{% endblock %}
