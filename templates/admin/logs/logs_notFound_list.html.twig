{% extends 'admin/base.html.twig' %}

{% block content %}

    <div class="container">

        {% include 'admin/_components/admin_tabs.html.twig' with {'adminTabs': adminTabs} only %}
        {% include 'admin/_components/admin_top.html.twig' with {'adminTop': adminTop} only %}

        <table class="table is-fullwidth">
            <thead>
                <tr>
                    <th>{{ 'admin_logs.col_time'|trans }}</th>
                    <th>{{ 'admin_logs.col_ip'|trans }}</th>
                    <th>{{ 'admin_logs.col_url'|trans }}</th>
                    <th>{{ 'admin_logs.col_incident'|trans }}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for entry in recent %}
                    {% set isSuspicious = entry.url in suspiciousUrls %}
                    <tr>
                        <td class="is-nowrap">{{ entry.createdAt|date('Y-m-d H:i:s') }}</td>
                        <td class="is-nowrap">{{ entry.ip }}</td>
                        <td{% if isSuspicious %} class="has-text-danger"{% endif %}>
                            {{ entry.url|length > 60 ? entry.url|slice(0, 57) ~ '...' : entry.url }}
                        </td>
                        <td>
                            {% if entry.incident %}
                                <a href="{{ path('app_admin_security_incidents_show', {'id': entry.incident.id}) }}">
                                    <span class="icon"><i class="fa fa-shield-halved"></i></span>
                                </a>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_admin_not_found_log_suspicious_toggle', {'id': entry.id}) }}"
                               class="button-as-icon{% if isSuspicious %} has-text-danger{% else %} has-text-grey{% endif %}"
                               title="{{ (isSuspicious ? 'admin_logs.action_unmark_suspicious' : 'admin_logs.action_mark_suspicious')|trans }}"
                               data-post
                               data-csrf-token="{{ csrf_token('admin_not_found_log_suspicious' ~ entry.id) }}">
                                <span class="icon"><i class="fa fa-flag"></i></span>
                            </a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

    </div>

{% endblock %}
