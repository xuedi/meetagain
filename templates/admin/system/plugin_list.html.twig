{% extends 'admin/base.html.twig' %}

{% block content %}

    <div class="container">

        {% include 'admin/_components/admin_top.html.twig' with {'adminTop': adminTop} only %}

        <table class="table is-fullwidth">
            <thead>
            <tr>
                <th>{{ 'admin_system_plugins.col_version'|trans }}</th>
                <th>{{ 'admin_system_plugins.col_plugin_name'|trans }}</th>
                <th>{{ 'admin_system_plugins.col_description'|trans }}</th>
                <th>{{ 'admin_system_plugins.col_status'|trans }}</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for plugin in plugins %}
                <tr>
                    <td>{{ plugin.version }}</td>
                    <td>{{ plugin.name }}</td>
                    <td>{{ plugin.description|shortened(70) }}</td>
                    <td>
                        {% include '_components/toggle.html.twig' with {
                            'link': path('app_admin_plugin_toggle', {key: plugin.key}),
                            'status': plugin.enabled,
                            'csrfTokenId': 'app_admin_plugin_toggle' ~ plugin.key,
                            'noAjax': true,
                            'disabled': plugin.system,
                        } %}
                    </td>
                    <td>
                        {% if plugin.key in configurableKeys %}
                            {% if plugin.enabled %}
                                <a href="{{ path('app_admin_plugin_settings', {key: plugin.key}) }}" title="{{ 'admin_system_plugins.button_configure'|trans }}">
                                    <span class="icon"><i class="fa fa-cog"></i></span>
                                </a>
                            {% else %}
                                <span class="icon has-text-grey-light" title="{{ 'admin_system_plugins.button_configure_inactive'|trans }}"><i class="fa fa-cog"></i></span>
                            {% endif %}
                        {% endif %}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

    </div>

{% endblock %}
