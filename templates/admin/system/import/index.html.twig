{% extends 'admin/base.html.twig' %}

{% block content %}

    <div class="container">

        {% include 'admin/_components/admin_tabs.html.twig' with {'adminTabs': adminTabs} only %}
        {% include 'admin/_components/admin_top.html.twig' with {'adminTop': adminTop} only %}

        {% if error %}
            <div class="notification is-danger is-light">
                <strong>{{ 'admin_system_import.failed'|trans }}</strong> {{ error }}
            </div>
        {% endif %}

        {% if archive %}
            <h2 class="title is-5 mb-2">{{ archive.name }}</h2>
            {% if archive.exported_at %}
                <p class="has-text-grey mb-3">{{ 'admin_system_import.exported_at'|trans({'%date%': archive.exported_at|date('Y-m-d')}) }}</p>
            {% endif %}
            {% if archive.description %}
                <p class="mb-4">{{ archive.description }}</p>
            {% endif %}

            <div class="columns">
                <div class="column">
                    <table class="table is-fullwidth">
                        <thead>
                            <tr>
                                <th>{{ 'admin_system_import.col_kind'|trans }}</th>
                                <th>{{ 'admin_system_import.col_rows'|trans }}</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for kind, rows in archive.counts %}
                                <tr>
                                    <td>{{ labels[kind] }}</td>
                                    <td>{{ rows }}</td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% if archive.plugins is not empty %}
                    <div class="column">
                        <table class="table is-fullwidth">
                            <thead>
                                <tr>
                                    <th>{{ 'admin_system_import.col_plugin'|trans }}</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for pluginKey in archive.plugins %}
                                    <tr>
                                        <td>{{ pluginNames[pluginKey] }}</td>
                                        <td>
                                            {% if pluginKey in archive.missing_plugins %}
                                                <span class="has-text-danger">{{ 'admin_system_import.plugin_missing'|trans }}</span>
                                            {% else %}
                                                <span class="has-text-success">{{ 'admin_system_import.plugin_active'|trans }}</span>
                                            {% endif %}
                                        </td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% endif %}
            </div>

            <form method="post" action="{{ path('app_admin_system_import_run') }}">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_system_import_run') }}">
                <div class="field">
                    <label class="checkbox">
                        <input type="checkbox" name="site_settings" value="1"{% if siteSettingsDefault %} checked{% endif %}>
                        {{ 'admin_system_import.label_site_settings'|trans }}
                    </label>
                </div>
                <button type="submit" class="button is-primary">
                    <span class="icon"><i class="fas fa-file-import"></i></span>
                    <span>{{ 'admin_system_import.button'|trans }}</span>
                </button>
            </form>
        {% else %}
            {% if summary %}
                <table class="table is-fullwidth">
                    <thead>
                        <tr>
                            <th>{{ 'admin_system_import.col_kind'|trans }}</th>
                            {% for outcome in outcomes %}
                                <th>{{ outcome.label()|trans }}</th>
                            {% endfor %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for kind in summary.counts|keys %}
                            <tr>
                                <td>{{ labels[kind] }}</td>
                                {% for outcome in outcomes %}
                                    <td>{{ summary.get(kind, outcome) }}</td>
                                {% endfor %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
                <p class="has-text-grey mb-5">{{ 'admin_system_import.note'|trans }}</p>
            {% endif %}

            <form method="post" action="{{ path('app_admin_system_import') }}" enctype="multipart/form-data">
                <div class="field">
                    <label class="label">{{ 'admin_system_import.label_zip_file'|trans }}</label>
                    <div class="control">
                        <input class="input" type="file" name="import_file" accept=".zip" required>
                    </div>
                </div>
                <button type="submit" class="button is-primary">
                    <span class="icon"><i class="fas fa-upload"></i></span>
                    <span>{{ 'admin_system_import.button_preview'|trans }}</span>
                </button>
            </form>
        {% endif %}

    </div>

{% endblock %}
