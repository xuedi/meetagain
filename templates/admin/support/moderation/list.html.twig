{% extends 'admin/base.html.twig' %}

{% block content %}

    <div class="container">

        {% include 'admin/_components/admin_tabs.html.twig' with {'adminTabs': adminTabs} only %}
        {% include 'admin/_components/admin_top.html.twig' with {'adminTop': adminTop} only %}

        <table class="table is-fullwidth">
            <thead>
            <tr>
                <th>{{ 'admin_support_moderation.col_date'|trans }}</th>
                <th>{{ 'admin_support_moderation.col_type'|trans }}</th>
                <th>{{ 'admin_support_moderation.col_subject'|trans }}</th>
                <th>{{ 'admin_support_moderation.col_reason'|trans }}</th>
                <th>{{ 'admin_support_moderation.col_reporter'|trans }}</th>
                <th>{{ 'admin_support_moderation.col_status'|trans }}</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for report in reports %}
                <tr>
                    <td>
                        {{ report.createdAt|date('Y-m-d') }}<br>
                        <small class="has-text-grey">{{ report.createdAt|date('H:i:s') }}</small>
                    </td>
                    <td><span class="tag is-light">{{ report.subjectType }}</span></td>
                    <td>
                        {{ report.subjectLabel }}
                        {% if report.excerpt %}
                            <br><small class="has-text-grey">{{ report.excerpt|shortened(50) }}</small>
                        {% endif %}
                    </td>
                    <td>{{ report.reason.label()|trans }}</td>
                    <td>
                        {% if report.reporter %}
                            {{ report.reporter.name }}
                        {% else %}
                            <span class="has-text-grey">{{ 'admin_support_moderation.label_deleted'|trans }}</span>
                        {% endif %}
                    </td>
                    <td><span class="tag {{ report.status.tagVariant() }}">{{ report.status.label()|trans }}</span></td>
                    <td>
                        <a href="{{ path('app_admin_support_moderation_show', {id: report.id}) }}">
                            <span class="icon"><i class="fa fa-eye"></i></span>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="7" class="has-text-centered has-text-grey">
                        {{ 'admin_support_moderation.empty'|trans }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

    </div>

{% endblock %}
