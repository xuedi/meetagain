{% extends 'admin/base.html.twig' %}

{% block content %}

    <div class="container">

        {% include 'admin/_components/admin_tabs.html.twig' with {'adminTabs': adminTabs} only %}
        {% include 'admin/_components/admin_top.html.twig' with {'adminTop': adminTop} only %}

        <div class="columns">
            <div class="column is-5">
                <table class="table is-fullwidth">
                    <tbody>
                        <tr>
                            <th>{{ 'admin_support.label_id'|trans }}</th>
                            <td><code>{{ request.id }}</code></td>
                        </tr>
                        <tr>
                            <th>{{ 'admin_support.col_date'|trans }}</th>
                            <td>{{ request.createdAt|date('Y-m-d H:i:s') }}</td>
                        </tr>
                        <tr>
                            <th>{{ 'admin_support.col_audience'|trans }}</th>
                            <td><span class="tag is-light">{{ request.audience.label()|trans }}</span></td>
                        </tr>
                        <tr>
                            <th>{{ 'admin_support.col_requester'|trans }}</th>
                            <td>
                                {{ request.requesterLabel ?? 'admin_support.requester_guest'|trans }}
                                {% if request.requester %}
                                    <span class="tag is-info is-light">{{ 'admin_support.requester_member'|trans }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>{{ 'admin_support.col_email'|trans }}</th>
                            <td>
                                {% if request.email is null %}
                                    <span class="has-text-grey">{{ 'admin_support.email_none'|trans }}</span>
                                {% elseif request.isEmailVerified() %}
                                    <a href="mailto:{{ request.email }}">{{ request.email }}</a>
                                    <span class="tag is-success">{{ 'admin_support.email_verified'|trans({'%date%': request.emailVerifiedAt|date('Y-m-d')}) }}</span>
                                {% else %}
                                    {{ request.email }}
                                    <span class="tag is-warning">{{ 'admin_support.email_unverified'|trans }}</span>
                                {% endif %}
                            </td>
                        </tr>
                        <tr>
                            <th>{{ 'admin_support.col_channel'|trans }}</th>
                            <td>{{ request.channel.label()|trans }}</td>
                        </tr>
                        {% if request.token %}
                            <tr>
                                <th>{{ 'admin_support.col_external'|trans }}</th>
                                <td>
                                    <a href="{{ url('app_support_thread', {'token': request.token}) }}"
                                       class="button is-small" target="_blank" rel="noopener">
                                        <span class="icon"><i class="fa fa-external-link"></i></span>
                                        <span>{{ 'admin_support.link_open_user_thread'|trans }}</span>
                                    </a>
                                </td>
                            </tr>
                        {% endif %}
                        <tr>
                            <th>{{ 'admin_support.col_status'|trans }}</th>
                            <td>
                                <span class="tag {{ request.status.tagVariant() }}">{{ request.status.label()|trans }}</span>
                            </td>
                        </tr>
                        {% if request.hasInvitedAdmins() %}
                            <tr>
                                <th>{{ 'admin_support.col_admins_invited'|trans }}</th>
                                <td>
                                    {{ 'admin_support.admins_invited_by'|trans({
                                        '%name%': request.invitedAdminsBy ? request.invitedAdminsBy.name : 'admin_support.invited_by_unknown'|trans,
                                        '%date%': request.invitedAdminsAt|date('Y-m-d H:i'),
                                    }) }}
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>

                {% if request.canInviteAdmins() %}
                    <p class="has-text-grey is-size-7">{{ 'admin_support.invite_admins_hint'|trans }}</p>
                {% endif %}
                {% if request.email is not null and not request.isEmailVerified() %}
                    <p class="has-text-grey is-size-7 mt-2">{{ 'admin_support.email_unverified_note'|trans }}</p>
                {% endif %}
            </div>

            <div class="column">
                <h2 class="title is-6">{{ 'admin_support.thread_heading'|trans }}</h2>

                {% for message in messages %}
                    <div class="box">
                        <p class="is-size-7 has-text-grey mb-2">
                            {% if message.isFromAdmin() %}
                                <strong>{{ message.authorUser ? message.authorUser.name : 'admin_support.thread_author_team'|trans }}</strong>
                            {% else %}
                                <strong>{{ request.requesterLabel ?? 'admin_support.requester_guest'|trans }}</strong>
                            {% endif %}
                            &middot; {{ message.createdAt|date('Y-m-d H:i:s') }}
                        </p>
                        <div>{{ message.content|safe_message }}</div>
                    </div>
                {% endfor %}

                {% if request.hasInvitedAdmins() %}
                    <p class="has-text-grey is-size-7 mb-4">
                        <span class="icon is-small"><i class="fa fa-user-plus"></i></span>
                        {{ 'admin_support.admins_invited_by'|trans({
                            '%name%': request.invitedAdminsBy ? request.invitedAdminsBy.name : 'admin_support.invited_by_unknown'|trans,
                            '%date%': request.invitedAdminsAt|date('Y-m-d H:i'),
                        }) }}
                    </p>
                {% endif %}

                {{ form_start(replyForm, {'action': path('app_admin_support_reply', {'id': request.id})}) }}
                {{ form_row(replyForm.response) }}
                <button class="button is-primary mt-2">{{ 'admin_support.button_reply_send'|trans }}</button>
                {{ form_end(replyForm) }}
            </div>
        </div>

    </div>

{% endblock %}
