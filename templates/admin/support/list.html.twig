{% extends 'admin/base.html.twig' %}

{% block content %}

    <div class="container">

        {% include 'admin/_components/admin_tabs.html.twig' with {'adminTabs': adminTabs} only %}
        {% include 'admin/_components/admin_top.html.twig' with {'adminTop': adminTop} only %}

        <table class="table is-fullwidth">
            <thead>
            <tr>
                <th>{{ 'admin_support.col_date'|trans }}</th>
                <th>{{ 'admin_support.col_audience'|trans }}</th>
                <th>{{ 'admin_support.col_requester'|trans }}</th>
                <th>{{ 'admin_support.col_email'|trans }}</th>
                <th>{{ 'admin_support.col_status'|trans }}</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            {% for request in requests %}
                <tr>
                    <td class="is-nowrap">{{ request.createdAt|date('Y-m-d H:i:s') }}</td>
                    <td><span class="tag is-light">{{ request.audience.label()|trans }}</span></td>
                    <td>
                        {% if request.isNew() %}<strong>{% endif %}
                        {{ request.requesterLabel ?? 'admin_support.requester_guest'|trans }}
                        {% if request.isNew() %}</strong>{% endif %}
                    </td>
                    <td>{{ request.email ?? '' }}</td>
                    <td>
                        <span class="tag {{ request.status.tagVariant() }}">{{ request.status.label()|trans }}</span>
                        {% if request.hasInvitedAdmins() %}
                            <span class="tag is-info is-light" title="{{ 'admin_support.admins_invited_by'|trans({
                                '%name%': request.invitedAdminsBy ? request.invitedAdminsBy.name : 'admin_support.invited_by_unknown'|trans,
                                '%date%': request.invitedAdminsAt|date('Y-m-d H:i'),
                            }) }}">{{ 'admin_support.tag_admins_invited'|trans }}</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="{{ path('app_admin_support_request_show', {id: request.id}) }}">
                            <span class="icon"><i class="fa fa-eye"></i></span>
                        </a>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="6" class="has-text-centered has-text-grey">
                        {{ 'admin_support.empty_requests'|trans }}
                    </td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

    </div>

{% endblock %}
