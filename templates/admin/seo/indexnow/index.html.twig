{% extends 'admin/base.html.twig' %}

{% block content %}

    <div class="container">

        {% include 'admin/_components/admin_tabs.html.twig' with {'adminTabs': adminTabs} only %}
        {% include 'admin/_components/admin_top.html.twig' with {'adminTop': adminTop} only %}

        <div class="columns">
            <div class="column is-6">

                <h1 class="title is-5">{{ 'admin_seo_indexnow.heading'|trans }}</h1>
                <p class="content">{{ 'admin_seo_indexnow.help'|trans }}</p>

                {% if indexNowKey %}
                    <p class="is-size-7 has-text-grey">{{ 'admin_seo_indexnow.key'|trans }} <code>{{ indexNowKey }}</code></p>
                {% endif %}
                {% if lastSubmittedAt %}
                    <p class="is-size-7 has-text-grey">{{ 'admin_seo_indexnow.last_submitted'|trans({'%time%': lastSubmittedAt|ago}) }}</p>
                {% else %}
                    <p class="is-size-7 has-text-grey">{{ 'admin_seo_indexnow.never_submitted'|trans }}</p>
                {% endif %}

            </div>
        </div>

    </div>

{% endblock %}
