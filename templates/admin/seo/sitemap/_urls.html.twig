{#
    Sitemap URLs -- the published URL list of one host, one row per entry.

    Renders the whole table: header, body and the per-row content warnings. Callers differ only in
    which host's rows they pass in, so the markup lives here rather than in each page.

    Used in:    templates/admin/seo/sitemap/index.html.twig
    Parameters:
        - rows (list<App\ValueObject\SitemapRow>, required)  -- entries to render
#}
<table id="filteredTable" class="table is-fullwidth is-hoverable">
    <thead>
        <tr>
            <th>{{ 'admin_seo_sitemap.col_section'|trans }}</th>
            <th>{{ 'admin_seo_sitemap.col_locale'|trans }}</th>
            <th>{{ 'admin_seo_sitemap.col_label'|trans }}</th>
            <th>{{ 'admin_seo_sitemap.col_url'|trans }}</th>
            <th>{{ 'admin_seo_sitemap.col_last_mod'|trans }}</th>
            <th>{{ 'admin_seo_sitemap.col_warnings'|trans }}</th>
        </tr>
    </thead>
    <tbody>
    {% for entry in rows %}
        <tr>
            <td><span class="tag is-light">{{ entry.section }}</span></td>
            <td><span class="tag is-light">{{ entry.locale|upper }}</span></td>
            <td>{{ entry.label }}</td>
            <td>
                <a href="{{ entry.url }}" target="_blank" rel="noopener" class="is-size-7 has-text-grey">
                    {{ entry.url }}
                </a>
            </td>
            <td>{{ entry.lastmod }}</td>
            <td>
                {% for warning in entry.warnings %}
                    <span class="tag is-warning is-light">{{ warning|trans }}</span>
                {% endfor %}
            </td>
        </tr>
    {% endfor %}
    </tbody>
</table>
