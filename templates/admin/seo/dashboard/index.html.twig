{% extends 'admin/base.html.twig' %}

{% block content %}
<div class="container">

    {% include 'admin/_components/admin_tabs.html.twig' with {'adminTabs': adminTabs} only %}
    {% include 'admin/_components/admin_top.html.twig' with {'adminTop': adminTop} only %}

    <div class="columns is-multiline">
        {% for tile in tiles %}
            <div class="column is-3-desktop is-6-tablet">
                {% include 'admin/_components/dashboard/' ~ tile.partial with {'tile': tile} only %}
            </div>
        {% endfor %}
    </div>

    <div class="columns">
        <div class="column is-6">
            {% include 'admin/_components/dashboard/' ~ details.partial with {'tile': details} only %}
        </div>
    </div>

</div>
{% endblock %}
