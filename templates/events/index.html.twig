{% extends 'base.html.twig' %}

{% block title %}{{ "events.page_title_event"|trans }}{% endblock %}
{% block meta_description %}{{ get_meta_description('events') }}{% endblock %}
{% block calendar_link %}<link rel="alternate" type="text/calendar" title="{{ 'events.calendar_feed_title'|trans }}" href="{{ url('app_event_calendar_feed') }}" />{% endblock %}

{% block body %}

    {% if hasFeatured or newEventLink %}
    <section class="section mt-1 is-hidden-desktop has-text-centered">
        {% if newEventLink %}
            {{ _self.new_event_button(newEventLink) }}
        {% endif %}
        {% if hasFeatured %}
        <a class="button has-background-info-light" href="{{ path('app_event_featured') }}">
                        <span class="icon has-text-warning">
                            <i class="fa-regular fa-star"></i>
                        </span>
            <span>{{ "events.button_featured" | trans }}</span>
        </a>
        {% endif %}
    </section>
    {% endif %}

    <section class="section mt-1 is-hidden-mobile">
        <div class="container">

            <nav class="level">
                <!-- Left side -->
                <div class="level-left">
                    {% if newEventLink %}
                        <div class="level-item">
                            {{ _self.new_event_button(newEventLink) }}
                        </div>
                    {% endif %}
                    <div class="level-item">
                        {{ form_start(filter, {'attr': {'id': 'eventFilter'}}) }}

                        {{ form_row(filter.time) }}
                        {{ form_row(filter.sort) }}
                        {{ form_row(filter.type) }}
                        {{ form_row(filter.rsvp) }}

                        {% if filter.group is defined %}
                            {{ form_row(filter.group) }}
                        {% endif %}

                        <button class="button is-link">{{ 'events.button_filter'|trans }}</button>
                        {{ form_end(filter) }}
                    </div>
                </div>

                <!-- Right side -->
                <div class="level-right">
                    {% if hasFeatured %}
                    <a class="button has-background-info-light" href="{{ path('app_event_featured') }}">
                        <span class="icon has-text-warning">
                            <i class="fa-regular fa-star"></i>
                        </span>
                        <span>{{ "events.button_featured" | trans }}</span>
                    </a>
                    {% endif %}
                </div>
            </nav>

        </div>
    </section>



    {# Collect all event IDs upfront to batch-warm plugin caches in a single query #}
    {% set allEventIds = [] %}
    {% for item in structuredList %}
        {% for event in item.events %}
            {% set allEventIds = allEventIds|merge([event.id]) %}
        {% endfor %}
    {% endfor %}
    {% if allEventIds is not empty %}{{ warm_event_list_item_tags(allEventIds) }}{% endif %}

    {% for item in structuredList %}
        <section class="section py-3 is-hidden-mobile">
            <div class="container">

                <div class="columns">
                    <div class="column is-2">
                        <div class="mt-1">
                            <div class=" is-size-5">{{ item.month }} {{ item.year }}</div>
                        </div>
                    </div>
                    <div class="column is-10">
                        <hr>
                    </div>
                </div>

            </div>
        </section>

        {% for event in item.events %}
            <section class="section py-3">
                <div class="container">
                    <div class="columns">
                        <div class="column is-2 is-hidden-mobile">
                            <div class="mt-1">
                                <p class="has-text-centered is-size-6">{{ event.start|date('D')|upper }}</p>
                                <p class="has-text-centered is-size-3 has-text-weight-bold">{{ event.start|date('d') }}</p>
                            </div>
                        </div>
                        <div class="column is-7">
                            <div class="is-flex is-justify-content-space-between is-align-items-center mb-3">
                                <p class="subtitle is-7 mb-0">{{ event.start|date('d. F Y @ H:i') }}</p>
                                {% if editLinks[event.id] is defined %}
                                    {% include 'events/_partials/edit_icon.html.twig' with {link: editLinks[event.id], sizeClass: 'is-size-7'} only %}
                                {% endif %}
                            </div>
                            <a class="title is-4 mt-1" href="{{ path('app_event_details', { 'id': event.id }) }}">{{ event.title(app.locale) }}</a>

                            {# Display tags from plugins (groups, categories, status, etc.) #}
                            {{ event_list_item_tags(event.id) }}

                            {% if event.canceled %}
                                <span class="tag is-danger ml-2">{{ "events.tag_canceled"|trans }}</span>
                            {% endif %}
                            <p class="mt-3">
                                {% if event.teaser(app.locale) is not null and event.teaser(app.locale) is not empty %}
                                    {{ event.teaser(app.locale) }}
                                {% else %}
                                    {{ event.description(app.locale)|striptags|slice(0, 240) }} ...
                                {% endif %}
                            </p>
                            <div class="mt-3 is-flex is-justify-content-space-between is-align-items-flex-start">
                                <div class="tags">
                                    <span class="tag is-warning">RSVP</span>
                                    {% for user in event.rsvp %}
                                        <span class="tag">{{ user.name }}</span>
                                    {% endfor %}
                                </div>
                                {% if event.externalRsvp > 0 %}
                                    <span class="tag ml-2"
                                          title="{{ 'events.rsvp_external_title'|trans }}">{{ 'events.rsvp_external_badge'|trans({'%count%': event.externalRsvp}) }}</span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="column is-3">
                            <figure class="image is-3by2">
                                <a href="{{ path('app_event_details', { 'id': event.id }) }}">
                                    {% include '_components/image.html.twig' with {'image': event.previewImage, 'size': '600x400'} %}
                                </a>
                            </figure>
                        </div>
                    </div>
                </div>
            </section>

            <section class="section py-3 is-hidden-tablet">
                <div class="container">
                    <div class="column is-10">
                        <hr>
                    </div>
                </div>
            </section>

        {% endfor %}

    {% endfor %}

    {% set calendarFeedUrl = url('app_event_calendar_feed') %}
    <section class="section py-5">
        <div class="container">
            <div class="columns is-centered">
                <div class="column is-half">
                    <article class="message">
                        <div class="message-body">
                            <p class="has-text-weight-semibold">{{ 'events.calendar_subscribe_heading'|trans }}</p>
                            <p class="mb-4">{{ 'events.calendar_subscribe_intro'|trans }}</p>
                            <div class="columns is-vcentered">
                                <div class="column is-narrow">
                                    <a class="button is-link" href="{{ calendarFeedUrl|replace({'https://': 'webcal://', 'http://': 'webcal://'}) }}">
                                        <span class="icon"><i class="fa-regular fa-calendar-plus"></i></span>
                                        <span>{{ 'events.button_subscribe_calendar'|trans }}</span>
                                    </a>
                                </div>
                                <div class="column">
                                    <label class="label is-small mb-1" for="calendarFeedUrl">{{ 'events.calendar_subscribe_manual'|trans }}</label>
                                    <input class="input is-small" id="calendarFeedUrl" type="text" readonly value="{{ calendarFeedUrl }}">
                                </div>
                            </div>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </section>

{% endblock %}

{% macro new_event_button(link) %}
    {% set label = (link.admin ? 'events.button_new_event' : 'events.button_suggest_event')|trans %}
    <a class="button" href="{{ link.url }}">
        <span class="icon"><i class="fas fa-plus" aria-hidden="true"></i></span>
        <span>{{ label }}</span>
    </a>
{% endmacro %}
