
{% include '_components/image.html.twig' with {'image': event.previewImage, 'size': '600x400'} %}
{% set hasAttachControl = attachControl is defined and attachControl and not attachControl.isEmpty %}
{% if itemCells is not empty or hasAttachControl %}
    <div class="box mt-5">
        <h2 class="title is-4">{{ 'item.heading'|trans }}</h2>
        {% for cell in itemCells %}
            <div class="item-cell mt-3">{{ cell|raw }}</div>
        {% endfor %}
        {% if hasAttachControl %}
            {% include 'events/details/item_attach.html.twig' with {'attachControl': attachControl} %}
        {% endif %}
    </div>
{% endif %}
{% for tile in pluginTiles %}
    <div class="box mt-5">
        {{ tile|raw }}
    </div>
{% endfor %}
<div class="box mt-5">
    <div class="level is-mobile mb-0">
        <div class="level-left">
            <strong>{{ event.start|date('d. F Y') }}</strong>
        </div>
        {% if editLink %}
            <div class="level-right">
                {% include 'events/_partials/edit_icon.html.twig' with {link: editLink, sizeClass: ''} only %}
            </div>
        {% endif %}
    </div>
    <p>
        {{ 'events.time_range'|trans({'%from%': event.start|date('H:i'), '%to%': event.stop|date('H:i')}) }}<br>
        {% if event.series and event.series.rule %}
            {{ 'events.label_recurring'|trans }}
            {{ recurrence_label(event.series.rule, event.series.ruleSpec, event.start) }}
        {% endif %}
    </p>
</div>
<div class="box mt-5">
    <h2 class="title is-4">{{ 'events.label_hosts'|trans }}</h2>
    <div class="columns is-multiline">
        {% for host in event.host %}
            <div class="tag is-large m-1">{{ host.user ? host.user.name : host.name }}</div>
        {% endfor %}
    </div>
</div>
<div class="box mt-5">
    <div class="level is-mobile mb-3">
        <div class="level-left">
            <h2 class="title is-4 mb-0">{{ 'events.label_location'|trans }}</h2>
        </div>
        {% if is_granted('ROLE_USER') and event.location %}
            <div class="level-right">
                <a href="{{ path('app_contribution_correct', {type: 'location', id: event.location.id}) }}"
                   class="icon has-text-grey"
                   title="{{ 'location.link_edit_venue'|trans }}"
                   aria-label="{{ 'location.link_edit_venue'|trans }}">
                    <i class="fas fa-pen"></i>
                </a>
            </div>
        {% endif %}
    </div>
    {% if event.location %}
        <strong>{{ event.location.name }}</strong>
        <p>
            {{ event.location.street }}<br>
            {{ event.location.postcode }} {{ event.location.city }}
        </p>
        {% if event.location.description != '' %}
            <p class="mt-5">
                {{ event.location.description }}
            </p>
        {% endif %}
        {% if event.hasMap and show_osm() %}
            <div class="mt-3" id="osm-map"
                 data-osm-map
                 data-lat="{{ event.location.latitude }}"
                 data-lng="{{ event.location.longitude }}"
                 data-marker-icon="{{ asset('images/leaflet/marker-icon.png') }}"
                 data-marker-shadow="{{ asset('images/leaflet/marker-shadow.png') }}"></div>
        {% endif %}
    {% else %}
        <p class="has-text-grey">{{ 'location.box_no_venue'|trans }}</p>
    {% endif %}
</div>
{% for tile in pluginBottomSidebarTiles %}
    {{ tile|raw }}
{% endfor %}
