{% extends 'base.html.twig' %}

{% block title %}{{ "security.page_title_register"|trans }}{% endblock %}
{% block meta_description %}{{ 'security.meta_description_register'|trans }}{% endblock %}

{% block body %}

    <section class="section">
        <div class="container">

            <div class="columns is-centered mt-5">
                <div class="column is-6-tablet is-5-desktop">

                    <h1 class="title is-5">{{ "security.headline_register"|trans }}</h1>
                    {% set redirectQuery = redirect|default(null) ? {'redirect': redirect} : {} %}
                    {% set loginPath = path('app_login', redirectQuery) %}

                    {{ form_start(form, {action: path('app_register', redirectQuery), attr: {'data-action': 'register-form-submit'}}) }}
                    {% if form.vars.submitted and not form.vars.valid %}<span hidden data-action="register-form-error" data-action-field="{{ form.children|filter(child => (child.vars.errors ?? [])|length > 0)|keys|join(',') }}"></span>{% endif %}

                    {% for flash_error in app.flashes('verify_email_error') %}
                        <div class="notification is-danger is-light mb-4" role="alert">{{ flash_error }}</div>
                    {% endfor %}

                    {{ form_errors(form) }}

                    {% set emailTaken = emailTaken|default(false) %}
                    {% for emailError in form.email.vars.errors %}
                        {% if emailError.message == 'security.validator_email_unique'|trans({}, 'validators') %}{% set emailTaken = true %}{% endif %}
                    {% endfor %}
                    {% if emailTaken %}
                        <p class="mb-4 is-size-7">
                            <a href="{{ loginPath }}">{{ 'security.register_exists_login'|trans }}</a>
                            &middot;
                            <a href="{{ path('app_reset') }}">{{ 'security.register_exists_reset'|trans }}</a>
                        </p>
                    {% endif %}

                    {{ form_row(form.name) }}
                    {{ form_row(form.email) }}
                    {{ form_row(form.plainPassword, {attr: {'data-password-toggle': 'security.aria_toggle_password'|trans}}) }}
                    {{ form_row(form.agreeTerms) }}

                    {% include '_components/human_check.html.twig' with {'form': form.meta} only %}

                    <div class="field is-grouped mt-4">
                        <div class="control">
                            <button class="button is-primary">{{ "security.button_register" | trans }}</button>
                            <a class="button is-light" data-action="register-terms-click" href="{{ path('app_catch_all', {'page': 'terms'}) }}" target="_blank" rel="noopener">{{ "security.button_terms" | trans }}</a>
                        </div>
                    </div>
                    {{ form_end(form) }}
                    {% include '_components/captcha_refresh.html.twig' with {'form': form.meta} only %}

                </div>

                <div class="column is-5-tablet is-4-desktop">
                    {% include '_components/info_sidebar.html.twig' with {
                        title: 'security.register_sidebar_title'|trans,
                        intro: 'security.register_sidebar_intro'|trans,
                        bullets: [
                            'security.register_sidebar_bullet1'|trans,
                            'security.register_sidebar_bullet2'|trans,
                            'security.register_sidebar_bullet3'|trans,
                        ],
                        link_url: loginPath,
                        link_text: 'security.register_sidebar_link'|trans,
                        link_icon: 'sign-in-alt',
                    } only %}
                </div>
            </div>

        </div>
    </section>

{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/captcha-counter.js') }}" defer></script>
    <script src="{{ asset('js/human-check.js') }}" defer></script>
    <script src="{{ asset('js/password-toggle.js') }}" defer></script>
{% endblock %}
