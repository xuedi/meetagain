        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.5, sum by (vmrange) (histogram_over_time(http_request_duration_ms{app=~\"$app\",env=~\"$env\"}[5m])))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (vmrange) (histogram_over_time(http_request_duration_ms{app=~\"$app\",env=~\"$env\"}[5m])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.99, sum by (vmrange) (histogram_over_time(http_request_duration_ms{app=~\"$app\",env=~\"$env\"}[5m])))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
