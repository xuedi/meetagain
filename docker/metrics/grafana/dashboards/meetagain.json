          "expr": "topk_max(10, histogram_quantile(0.95, sum by (route, vmrange) (histogram_over_time(http_request_duration_ms{app=~\"$app\",env=~\"$env\"}[5m]))))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
